const DB={players:[],maps:[],matches:[],aliases:{}};
const BASE={players:[],maps:[],matches:[],aliases:{}};
const state={tab:'home',logged:false,selected:['gletcher'],focused:null,metric:'kd',map:'all',teamA:[],teamB:[],compare:['gletcher','donater'],detailPlayer:null,whatIfOut:'',whatIfIn:'',teamChange:null,teamMap:'mirage',recordFilter:'career',recordMetric:'kills',recordMap:'all',baseMode:'maps',showArchived:false,mapPlayer:'all',hydrationError:null,storageWarning:null,bootError:null,serverSync:false,serverVersion:null,serverBusy:false,cloudMode:false,cloudAdmin:false};
let SERVER_AUDIT=[]; let SERVER_EVENT_SOURCE=null; let SERVER_REFRESH_TIMER=null;
const $=s=>document.querySelector(s);
function toast(message){let box=document.getElementById('toast');if(!box){box=document.createElement('div');box.id='toast';box.className='toast';document.body.appendChild(box)}box.textContent=String(message||'');box.classList.add('show');clearTimeout(window.__cs2ToastTimer);window.__cs2ToastTimer=setTimeout(()=>box.classList.remove('show'),2600)}
const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));
const fmt=(x,n=2)=>Number.isFinite(x)?x.toFixed(n):'—';
const metricLabels={kd:'K/D',diff:'K-D',kills:'K',deaths:'D',assists:'A',avg:'AVG',impact:'Импакт',index:'Индекс игрока',form:'Форма',stability:'Стабильность'};
const mapKey=name=>String(name||'').trim().toLowerCase();
const mapAsset=name=>`assets/maps/${encodeURIComponent(mapKey(name))}.svg`;
const mapRemoteAsset=name=>`https://raw.githubusercontent.com/ghostcap-gaming/cs2-map-images/main/cs2/de_${encodeURIComponent(mapKey(name))}.png`;
const mapIconRemoteAsset=name=>`https://raw.githubusercontent.com/MurkyYT/cs2-map-icons/main/images/de_${encodeURIComponent(mapKey(name))}.png`;
const mapBg=name=>`linear-gradient(180deg,rgba(3,9,16,.04),rgba(3,9,16,.72)),url('${mapRemoteAsset(name)}'),url('${mapAsset(name)}')`;
function migrateLegacyStorage(){const pairs=[['cs5_base_override','cs2_analytics_base_override'],['cs5_additions','cs2_analytics_additions'],['cs5_audit_log','cs2_analytics_audit_log']];for(const [oldKey,newKey] of pairs){try{if(localStorage.getItem(newKey)===null){const old=localStorage.getItem(oldKey);if(old!==null)localStorage.setItem(newKey,old)}if(localStorage.getItem(newKey)!==null)localStorage.removeItem(oldKey)}catch{}}}

const trendMarkup=(value,label='')=>{const n=Number(value);if(!Number.isFinite(n))return `<em class="trend-flat">— ${esc(label)}</em>`;const up=n>=0;return `<em class="${up?'trend-up':'trend-down'}">${up?'↑':'↓'} ${fmt(Math.abs(n),1)}${label?` ${esc(label)}`:''}</em>`};
const mapThumb=(name,size='')=>`<div class="map-thumb ${size}" style="background-image:${mapBg(name)}"><img class="map-logo-mini" src="${mapIconRemoteAsset(name)}" alt="" onerror="this.style.display='none'"><span>${esc(name||'CS2')}</span></div>`;

async function loadData(name){try{const r=await fetch('data/'+name+'.json',{cache:'no-store'});if(!r.ok)throw Error(`data/${name}.json: HTTP ${r.status}`);return r.json()}catch(e){const embedded=window.CS2_EMBEDDED_DATA?.[name];if(embedded)return embedded;throw e}}
async function loadServerState(){if(window.CS2Cloud?.configured){try{return await CS2Cloud.load()}catch(e){state.storageWarning='Облачная база пока недоступна: '+(e?.message||'ошибка подключения') ;return null}}if(location.protocol!=='http:'&&location.protocol!=='https:')return null;try{const r=await fetch('/api/state',{cache:'no-store'});if(!r.ok)return null;const x=await r.json();if(!validateBase(x))throw Error('Серверная база не прошла проверку');return x}catch{return null}}
function applyLoadedState(candidate,audit=[]){BASE.players=JSON.parse(JSON.stringify(candidate.players));BASE.maps=JSON.parse(JSON.stringify(candidate.maps));BASE.matches=JSON.parse(JSON.stringify(candidate.matches));BASE.aliases=JSON.parse(JSON.stringify(candidate.aliases));DB.players=JSON.parse(JSON.stringify(candidate.players));DB.maps=JSON.parse(JSON.stringify(candidate.maps));DB.matches=JSON.parse(JSON.stringify(candidate.matches));DB.aliases=JSON.parse(JSON.stringify(candidate.aliases));SERVER_AUDIT=Array.isArray(candidate.audit)?JSON.parse(JSON.stringify(candidate.audit)):Array.isArray(audit)?JSON.parse(JSON.stringify(audit)):[];normalizeState();}
async function load(){try{migrateLegacyStorage();const remote=await loadServerState();if(remote){state.serverSync=true;state.cloudMode=!!window.CS2Cloud?.configured;state.serverVersion=remote.updated_at||null;applyLoadedState(remote,remote.audit);if(state.cloudMode){try{state.cloudAdmin=await CS2Cloud.isAdmin();state.logged=state.cloudAdmin}catch{state.cloudAdmin=false;state.logged=false}}render();connectServerEvents();return}const [p,m,ma,a]=await Promise.all(['players','maps','matches','aliases'].map(loadData));let ov=null;try{ov=JSON.parse(localStorage.getItem('cs2_analytics_base_override')||'null')}catch{ov=null}const candidate=ov&&Array.isArray(ov.players)&&Array.isArray(ov.maps)&&Array.isArray(ov.matches)&&ov.aliases&&typeof ov.aliases==='object'?ov:{players:p.players,maps:m.maps,matches:ma.matches,aliases:a.aliases};if(!validateBase(candidate))throw Error('База не прошла проверку');applyLoadedState(candidate);hydrate();if(!validateBase(DB))throw Error('Локальные изменения повредили базу');render();if(state.hydrationError)toast(state.hydrationError);else if(state.storageWarning)toast(state.storageWarning)}catch(e){state.bootError=e?.message||'Не удалось загрузить базу';const v=$('#view');if(v)v.innerHTML=`<section class="section"><div class="panel card"><div class="eyebrow">SYSTEM ERROR</div><h2>База не загружена</h2><div class="notice">${esc(state.bootError)}</div><div class="footer-note">Проверь наличие папки data рядом с index.html. Данные не были изменены.</div><button class="btn primary" onclick="location.reload()">ПОВТОРИТЬ</button></div></section>`;}}
async function refreshFromServer(silent=false){if(!state.serverSync)return false;try{const x=window.CS2Cloud?.configured?await CS2Cloud.load():await (async()=>{const r=await fetch('/api/state',{cache:'no-store'});if(!r.ok)throw Error('server unavailable');return r.json()})();if(!validateBase(x))throw Error('invalid server state');applyLoadedState(x,x.audit);state.serverVersion=x.updated_at||null;render();if(!silent)toast('Данные синхронизированы');return true}catch(e){if(!silent)toast('Не удалось синхронизировать данные');return false}}
function connectServerEvents(){if(!state.serverSync||SERVER_EVENT_SOURCE)return;if(window.CS2Cloud?.configured){CS2Cloud.subscribe(()=>refreshFromServer(true));return}try{SERVER_EVENT_SOURCE=new EventSource('/api/events');SERVER_EVENT_SOURCE.addEventListener('update',()=>refreshFromServer(true));SERVER_EVENT_SOURCE.onerror=()=>{if(SERVER_REFRESH_TIMER)return;SERVER_REFRESH_TIMER=setInterval(()=>refreshFromServer(true),3000)}}catch{SERVER_REFRESH_TIMER=setInterval(()=>refreshFromServer(true),3000)}}
function hydrate(){let additions=[];try{additions=window.__cs2HydrateAdditions||null}catch{additions=null}if(!Array.isArray(additions)){additions=[];try{const raw=localStorage.getItem('cs2_analytics_additions');if(raw){const parsed=JSON.parse(raw);if(Array.isArray(parsed))additions=parsed;else state.storageWarning='Хранилище cs2_analytics_additions повреждено: ожидается массив. Используется безопасное пустое состояние.'}}catch{state.storageWarning='Хранилище cs2_analytics_additions повреждено: JSON не читается. Используется безопасное пустое состояние.'}}if(!additions.length)return;const snapshot=JSON.parse(JSON.stringify(DB));try{for(const x of additions){if(!x||typeof x!=='object')throw Error('invalid local operation');if(!['map','match','player','aliases','player_patch','match_patch','map_patch'].includes(x.kind))throw Error('unknown local operation');if(x.kind==='map'&&(!x.map||typeof x.map!=='object'))throw Error('map payload missing');if(x.kind==='match'&&(!x.match||typeof x.match!=='object'))throw Error('match payload missing');if(x.kind==='player'&&(!x.player||typeof x.player!=='object'))throw Error('player payload missing');if(x.kind==='aliases'&&(!x.aliases||typeof x.aliases!=='object'||Array.isArray(x.aliases)))throw Error('aliases payload missing');if(['player_patch','match_patch','map_patch'].includes(x.kind)&&(!x.patch||typeof x.patch!=='object'||Array.isArray(x.patch)))throw Error('patch payload missing');if(x.kind==='map'&&x.map)DB.maps.push(x.map);if(x.kind==='match'&&x.match)DB.matches.push(x.match);if(x.kind==='player'&&x.player)DB.players.push(x.player);if(x.kind==='aliases')Object.assign(DB.aliases,x.aliases||{});if(x.kind==='player_patch'){const p=DB.players.find(p=>p.player_id===x.player_id);if(!p)throw Error('player patch target missing');Object.assign(p,x.patch||{})}if(x.kind==='match_patch'){const m=DB.matches.find(m=>m.match_id===x.match_id);if(!m)throw Error('match patch target missing');Object.assign(m,x.patch||{})}if(x.kind==='map_patch'){const m=DB.maps.find(m=>m.map_id===x.map_id);if(!m)throw Error('map patch target missing');Object.assign(m,x.patch||{})}}if(!validateBase(DB))throw Error('invalid hydrated base')}catch{DB.players=snapshot.players;DB.maps=snapshot.maps;DB.matches=snapshot.matches;DB.aliases=snapshot.aliases;state.hydrationError='Локальные изменения не применены: обнаружена повреждённая или несовместимая запись. Исходная база сохранена.'}}
function validateBase(b){if(!b||!Array.isArray(b.players)||!Array.isArray(b.maps)||!Array.isArray(b.matches)||!b.aliases||typeof b.aliases!=='object')return false;try{if(!b||!Array.isArray(b.players)||!Array.isArray(b.maps)||!Array.isArray(b.matches)||!b.aliases||typeof b.aliases!=='object')return false;const uniq=(arr,key)=>{const s=new Set();for(const v of arr){const id=v&&v[key];if(!id||s.has(id))return false;s.add(id)}return true};if(!uniq(b.players,'player_id')||!uniq(b.maps,'map_id')||!uniq(b.matches,'match_id'))return false;if(b.players.some(p=>typeof p.player_id!=='string'||!/^[\p{L}\p{N}_.: -]{1,64}$/u.test(p.player_id)))return false;const pids=new Set(b.players.map(p=>p.player_id)),mids=new Set(b.matches.map(m=>m.match_id)),mapById=new Map(b.maps.map(m=>[m.map_id,m]));const listedMapIds=new Set();for(const m of b.matches)for(const id of (Array.isArray(m.map_ids)?m.map_ids:[])){if(listedMapIds.has(id))return false;listedMapIds.add(id)}for(const mp of b.maps)if(!listedMapIds.has(mp.map_id))return false;for(const [alias,pid] of Object.entries(b.aliases)){if(typeof alias!=='string'||!alias.trim()||typeof pid!=='string'||!pids.has(pid))return false}for(const m of b.maps){if(!mids.has(m.match_id)||!mapById.has(m.map_id))return false;if(!Number.isInteger(Number(m.map_index))||Number(m.map_index)<1)return false;const rows=Array.isArray(m.player_stats)?m.player_stats:[];if(m.stats_available===true&&rows.length===0)return false;if(m.stats_available===false&&rows.length>0)return false;const seen=new Set();for(const st of rows){if(!st||!Number.isFinite(Number(st.kills))||!Number.isFinite(Number(st.deaths))||!Number.isFinite(Number(st.assists)))return false;if(st.player_id!=null&&!pids.has(st.player_id))return false;const key=st.player_id||`raw:${st.raw_name||''}`;if(seen.has(key))return false;seen.add(key)}}for(const m of b.matches){if(!Array.isArray(m.map_ids)||!m.map_ids.length||new Set(m.map_ids).size!==m.map_ids.length)return false;if(m.format==='BO1'&&m.map_ids.length!==1)return false;if(m.format==='BO3'&&(m.map_ids.length<2||m.map_ids.length>3))return false;if(m.format==='BO5'&&(m.map_ids.length<2||m.map_ids.length>5))return false;if(m.format!=='BO1'&&m.format!=='BO3'&&m.format!=='BO5')return false;const ta=Array.isArray(m.team_a)?m.team_a:[],tb=Array.isArray(m.team_b)?m.team_b:[];if(ta.length||tb.length){if(ta.length>5||tb.length>5||(!ta.length&&!tb.length)||new Set([...ta,...tb]).size!==ta.length+tb.length||[...ta,...tb].some(pid=>!pids.has(pid)))return false}for(let i=0;i<m.map_ids.length;i++){const id=m.map_ids[i],mp=mapById.get(id);if(!mp||mp.match_id!==m.match_id||Number(mp.map_index)!==i+1)return false}const sas=Array.isArray(m.series_aggregate_stats)?m.series_aggregate_stats:[];if(m.source_kind==='compact_bo3'&&sas.length!==10)return false;const seen=new Set();for(const st of sas){if(!st||!Number.isFinite(Number(st.kills))||!Number.isFinite(Number(st.deaths))||!Number.isFinite(Number(st.assists)))return false;if(st.player_id!=null&&!pids.has(st.player_id))return false;const key=st.player_id||`raw:${st.raw_name||''}`;if(seen.has(key))return false;seen.add(key)}}return true}catch{return false}}
function activeMatches(){return DB.matches.filter(m=>m.archived!==true)}
function matchTime(m){const t=Date.parse(m?.played_at||m?.date||m?.created_at||'');return Number.isFinite(t)?t:0}
function matchOrder(m){const t=matchTime(m);if(t)return t;const id=String(m?.match_id||'');const n=id.match(/(\d+)(?:$)/);return n?Number(n[1]):0}
function mapOrder(m){const match=DB.matches.find(x=>x.match_id===m?.match_id);return [matchOrder(match),Number(m?.map_index||0)];}
function activeMapNumber(mapId){const n=Number(String(mapId||'').match(/(\d+)(?:$)/)?.[1]||0);return n||null}
function latestMatch(list=activeMatches()){return list.slice().sort((a,b)=>matchOrder(a)-matchOrder(b)||String(a.match_id).localeCompare(String(b.match_id))).at(-1)||null}
function matchMaps(match){return (match?.map_ids||[]).map(id=>DB.maps.find(x=>x.map_id===id)).filter(Boolean).filter(x=>x.archived!==true)}
function latestDetailedMap(match){return matchMaps(match).filter(x=>x.stats_available).at(-1)||null}
function mapScoreText(m){return m?.score&&Number.isFinite(Number(m.score.team_a))&&Number.isFinite(Number(m.score.team_b))?`${m.score.team_a}:${m.score.team_b}`:'—'}
function safeJsonArray(key){try{const raw=localStorage.getItem(key);if(!raw)return[];const v=JSON.parse(raw);if(!Array.isArray(v)){state.storageWarning=`Хранилище ${key} повреждено: ожидается массив. Используется безопасное пустое состояние.`;return[]}return v}catch{state.storageWarning=`Хранилище ${key} повреждено: JSON не читается. Используется безопасное пустое состояние.`;return[]}}
function auditLog(){return state.serverSync?SERVER_AUDIT.slice():safeJsonArray('cs2_analytics_audit_log')}
function logAudit(action,target,detail={}){const entry={id:'audit_'+Date.now()+'_'+Math.random().toString(36).slice(2,7),at:new Date().toISOString(),action,target,detail};if(state.serverSync){SERVER_AUDIT.push(entry);SERVER_AUDIT=SERVER_AUDIT.slice(-500);return}const log=auditLog();log.push(entry);localStorage.setItem('cs2_analytics_audit_log',JSON.stringify(log.slice(-500)))}
function additions(){return state.serverSync?[]:safeJsonArray('cs2_analytics_additions')}
function persistAdditions(a){if(state.serverSync){const xhr=new XMLHttpRequest();xhr.open('POST','/api/commit',false);xhr.setRequestHeader('Content-Type','application/json');xhr.send(JSON.stringify({operations:a.map((op,i)=>({...op,_sync_id:`${Date.now()}_${i}_${Math.random().toString(36).slice(2,8)}`}) )}));if(xhr.status<200||xhr.status>=300)throw Error('server commit failed');return}const next=JSON.stringify(a);const prev=localStorage.getItem('cs2_analytics_additions');try{localStorage.setItem('cs2_analytics_additions',next);if(localStorage.getItem('cs2_analytics_additions')!==next)throw Error('storage verification failed')}catch(e){try{if(prev===null)localStorage.removeItem('cs2_analytics_additions');else localStorage.setItem('cs2_analytics_additions',prev)}catch{};throw e}}
function persistChange(a,audit){if(state.serverSync){if(window.CS2Cloud?.configured){const entry=audit?{id:'audit_'+Date.now()+'_'+Math.random().toString(36).slice(2,7),at:new Date().toISOString(),action:audit.action,target:audit.target,detail:audit.detail||{}}:null;state.serverBusy=true;CS2Cloud.commit(a,entry).then(data=>{state.serverBusy=false;state.serverVersion=data.updated_at||null;if(entry){SERVER_AUDIT.push(entry);SERVER_AUDIT=SERVER_AUDIT.slice(-500)}}).catch(e=>{state.serverBusy=false;toast('Облачное сохранение не удалось: '+(e?.message||'ошибка'));refreshFromServer(true)});return true}const ops=a.map((op,i)=>({...op,_sync_id:`${Date.now()}_${i}_${Math.random().toString(36).slice(2,8)}`}));const entry=audit?{id:'audit_'+Date.now()+'_'+Math.random().toString(36).slice(2,7),at:new Date().toISOString(),action:audit.action,target:audit.target,detail:audit.detail||{}}:null;const xhr=new XMLHttpRequest();xhr.open('POST','/api/commit',false);xhr.setRequestHeader('Content-Type','application/json');xhr.send(JSON.stringify({operations:ops,audit:entry}));if(xhr.status<200||xhr.status>=300)throw Error('server commit failed');if(entry){SERVER_AUDIT.push(entry);SERVER_AUDIT=SERVER_AUDIT.slice(-500)}return true}const nextAdd=JSON.stringify(a);const prevAdd=localStorage.getItem('cs2_analytics_additions');const prevAudit=localStorage.getItem('cs2_analytics_audit_log');let nextAudit=prevAudit;if(audit){const log=auditLog();log.push({id:'audit_'+Date.now()+'_'+Math.random().toString(36).slice(2,7),at:new Date().toISOString(),action:audit.action,target:audit.target,detail:audit.detail||{}});nextAudit=JSON.stringify(log.slice(-500))}try{localStorage.setItem('cs2_analytics_additions',nextAdd);if(audit)localStorage.setItem('cs2_analytics_audit_log',nextAudit);if(localStorage.getItem('cs2_analytics_additions')!==nextAdd|| (audit&&localStorage.getItem('cs2_analytics_audit_log')!==nextAudit))throw Error('storage verification failed')}catch(e){try{if(prevAdd===null)localStorage.removeItem('cs2_analytics_additions');else localStorage.setItem('cs2_analytics_additions',prevAdd);if(prevAudit===null)localStorage.removeItem('cs2_analytics_audit_log');else localStorage.setItem('cs2_analytics_audit_log',prevAudit)}catch{};throw e}}
function normalizeState(){const ids=new Set(activePlayers().map(p=>p.player_id));const allIds=new Set(DB.players.map(p=>p.player_id));state.selected=state.selected.filter(id=>ids.has(id));if(!state.selected.length&&activePlayers()[0])state.selected=[activePlayers()[0].player_id];state.teamA=[...new Set(state.teamA.filter(id=>allIds.has(id)))].slice(0,5);state.teamB=[...new Set(state.teamB.filter(id=>allIds.has(id)&&!state.teamA.includes(id)))].slice(0,5)}
function activePlayers(){return DB.players.filter(p=>p.is_active!==false)}
function player(id){return DB.players.find(p=>p.player_id===id)}
function playerName(id){return player(id)?.display_name||id}
function detailMapsFor(id){const activeIds=new Set(activeMatches().map(x=>x.match_id));return DB.maps.filter(m=>m.archived!==true&&activeIds.has(m.match_id)&&m.stats_available&&m.player_stats.some(s=>s.player_id===id))}
function playedMapsFor(id){let n=detailMapsFor(id).length;for(const ma of activeMatches().filter(x=>x.source_kind==='compact_bo3'))if((ma.series_aggregate_stats||[]).some(s=>s.player_id===id))n+=matchMaps(ma).length;return n}
function aggregate(id,rows=detailRows(id),includeCompact=true){let k=0,d=0,a=0;for(const r of rows){k+=r.kills;d+=r.deaths;a+=r.assists}if(includeCompact)for(const m of activeMatches().filter(x=>x.source_kind==='compact_bo3'))for(const s of(m.series_aggregate_stats||[]))if(s.player_id===id){k+=s.kills;d+=s.deaths;a+=s.assists}const maps=includeCompact?playedMapsFor(id):rows.length;return{maps,detailed:rows.length,k,d,a,kd:d?k/d:0,kdDiff:k-d,kpm:maps?k/maps:0,apm:maps?a/maps:0,dpm:maps?d/maps:0}}
function stability(id,rows=detailRows(id),fullPool=true,totalOverride=null){const detailed=rows.length;if(!detailed)return{score:0,plus:0,total:totalOverride??(fullPool?playedMapsFor(id):0),detailed:0};const total=totalOverride??(fullPool?playedMapsFor(id):detailed);const rate=t=>rows.filter(r=>r.deaths>0&&r.kills/r.deaths>=t).length/Math.max(1,total);return{score:100*(.4*rate(1)+.3*rate(1.5)+.2*rate(2)+.1*rate(3)),plus:rows.filter(r=>r.kills>=r.deaths).length,total,detailed}}
function detailRows(id){const activeIds=new Set(activeMatches().map(x=>x.match_id));return DB.maps.filter(m=>m.archived!==true&&activeIds.has(m.match_id)&&m.stats_available).flatMap(m=>{const s=(m.player_stats||[]).find(x=>x.player_id===id);return s?[{...s,map:m.map,map_id:m.map_id,match_id:m.match_id,score:m.score}]:[]}).sort((a,b)=>{const ma=DB.matches.find(x=>x.match_id===a.match_id),mb=DB.matches.find(x=>x.match_id===b.match_id);return matchOrder(ma)-matchOrder(mb)||Number(a.score?.map_index||DB.maps.find(x=>x.map_id===a.map_id)?.map_index||0)-Number(b.score?.map_index||DB.maps.find(x=>x.map_id===b.map_id)?.map_index||0)})}
function formForRows(rows){if(!rows.length)return{form:null,trend:null,n:0};const last=rows.slice(-Math.min(10,rows.length)),first=rows.slice(0,Math.min(10,rows.length));const av=r=>r.reduce((z,x)=>z+x.kills-x.deaths,0)/r.length;return{form:av(last),trend:av(last)-av(first),n:last.length}}
function form(id,rows=detailRows(id)){return formForRows(rows)}
function formWindows(rows){const total=rows.length;if(!total)return[];const wanted=[1,5,10,15,25,50];const sizes=wanted.filter(n=>n<=total);if(total<25&&!sizes.includes(total))sizes.push(total);return [...new Set(sizes)].sort((a,b)=>a-b).map(n=>{const rr=rows.slice(-n),a=aggregateRows(rr);return{n,k:a.k,d:a.d,a:a.a,kd:a.kd,avg:a.maps?a.k/a.maps:0}})}
function aggregateRows(rows){let k=0,d=0,a=0;for(const r of rows){k+=Number(r.kills)||0;d+=Number(r.deaths)||0;a+=Number(r.assists)||0}return{maps:rows.length,k,d,a,kd:d?k/d:0,kdDiff:k-d}}
function impact(id,rows=detailRows(id),includeCompact=true){const x=aggregate(id,rows,includeCompact);return x.maps?clamp(50+5*((x.kdDiff/x.maps)+.5*x.apm),0,100):0}
function index(id,rows=detailRows(id),includeCompact=true){const x=aggregate(id,rows,includeCompact),st=stability(id,rows,true),fo=form(id,rows);const kdScore=clamp((x.kd-.5)*100,0,100),diffScore=clamp(((x.kdDiff/Math.max(1,x.maps))+5)/10*100,0,100),vol=clamp((x.kpm-10)*10,0,100),formScore=fo.form==null?0:clamp((fo.form+5)/10*100,0,100);return .35*kdScore+.25*diffScore+.15*impact(id,rows,includeCompact)+.10*st.score+.10*vol+.05*formScore}
function indexBreakdown(id,rows=detailRows(id),includeCompact=true,localStability=false){const x=aggregate(id,rows,includeCompact),st=stability(id,rows,!localStability),fo=form(id,rows),kdScore=clamp((x.kd-.5)*100,0,100),diffScore=clamp(((x.kdDiff/Math.max(1,x.maps))+5)/10*100,0,100),vol=clamp((x.kpm-10)*10,0,100),formScore=fo.form==null?0:clamp((fo.form+5)/10*100,0,100),imp=impact(id,rows,includeCompact),total=.35*kdScore+.25*diffScore+.15*imp+.10*st.score+.10*vol+.05*formScore;return{total,kdScore,diffScore,impact:imp,stability:st.score,volume:vol,formScore,kd:x.kd,diff:x.kdDiff,kpm:x.kpm,form:fo.form,trend:fo.trend,maps:x.maps}}
function eraRows(id){const rows=detailRows(id),out=[];for(let i=0;i<rows.length;i+=10){const rr=rows.slice(i,i+10),b=indexBreakdown(id,rr,false,true),a=aggregate(id,rr,false);out.push({from:i+1,to:i+rr.length,maps:rr.length,kd:a.kd,avg:a.maps?a.k/a.maps:0,idx:b.total})}return out}
function indexReasons(id){const rows=detailRows(id),b=indexBreakdown(id,rows,true),last=rows.at(-1),prev=rows.length>1?rows.slice(0,-1):rows,prevB=indexBreakdown(id,prev,true);if(!last)return[];const careerKD=b.kd, lastKD=last.deaths?last.kills/last.deaths:0, lastDiff=last.kills-last.deaths, avgDiff=rows.reduce((z,r)=>z+r.kills-r.deaths,0)/Math.max(1,rows.length),reasons=[];reasons.push(`${lastKD>=careerKD?'✓':'✕'} K/D последней подробных карты: ${fmt(lastKD)} · карьерный ${fmt(careerKD)}`);reasons.push(`${lastDiff>=avgDiff?'✓':'✕'} K-D последней карты: ${lastDiff>0?'+':''}${lastDiff} · средний ${avgDiff>0?'+':''}${fmt(avgDiff,1)}`);reasons.push(`${b.impact>=prevB.impact?'✓':'✕'} Импакт ${fmt(b.impact,1)} · до последней карты ${fmt(prevB.impact,1)}`);reasons.push(`${b.formScore>=prevB.formScore?'✓':'✕'} Форма ${fmt(b.form,1)} · тренд ${b.trend>=0?'+':''}${fmt(b.trend,1)}`);reasons.push(`${b.stability>=prevB.stability?'✓':'✕'} Стабильность ${fmt(b.stability,1)} · до последней карты ${fmt(prevB.stability,1)}`);return reasons}
function openWhyIndex(id){const p=player(id),b=indexBreakdown(id),rows=detailRows(id),avg=rows.length?rows.reduce((z,r)=>z+r.kills,0)/rows.length:0,kmap=rows.length?b.kpm:0,dmap=rows.length?rows.reduce((z,r)=>z+r.deaths,0)/rows.length:0,amap=rows.length?rows.reduce((z,r)=>z+r.assists,0)/rows.length:0;const items=[['K/D',`Текущий K/D игрока: ${fmt(b.kd)}. Чем выше отношение убийств к смертям, тем выше эта часть индекса.`,`${fmt(b.kd)} · вес 35%`],['K-D / карта',`Средняя разница убийств и смертей за карту: ${fmt(b.diff/Math.max(1,b.maps),1)}.`,`${fmt(b.diff/Math.max(1,b.maps),1)} · вес 25%`],['Импакт',`Сводный показатель влияния по доступным K/D/A-данным.`,`${fmt(b.impact,1)} · вес 15%`],['Стабильность',`Показывает, насколько ровно игрок держит результат по картам.`,`${fmt(b.stability,1)} · вес 10%`],['K/карта',`Средние убийства за подробную карту: ${fmt(kmap,2)}.`,`${fmt(kmap,2)} · вес 10%`],['Форма',`Изменение текущей формы относительно предыдущего отрезка.`,`${fmt(b.form??0,1)} · вес 5%`]];const calc=[['K/D',b.kdScore,.35],['K-D / карта',b.diffScore,.25],['Импакт',b.impact,.15],['Стабильность',b.stability,.10],['K/карта',b.volume,.10],['Форма',b.formScore,.05]];document.body.insertAdjacentHTML('beforeend',`<div class="modal-back" id="whyIndexModal"><div class="modal panel wide"><div class="modal-head"><div><div class="eyebrow">СПРАВОЧНИК МЕТРИК</div><h2>ПОЧЕМУ ИНДЕКС ${fmt(b.total,1)}</h2><div class="muted">${esc(p?.display_name||id)} · реальные значения этой базы</div></div><button class="close" onclick="$('#whyIndexModal')?.remove()">×</button></div><div class="why-guide">${items.map(r=>`<div class="why-guide-row"><div><b>${r[0]}</b><span>${r[1]}</span></div><strong>${r[2]}</strong></div>`).join('')}</div><div class="notice"><b>Как получается ${fmt(b.total,1)}:</b> каждую часть переводим в шкалу 0–100, умножаем на её вес и складываем: ${calc.map(x=>`${x[0]} ${fmt(x[1],1)} × ${Math.round(x[2]*100)}% = ${fmt(x[1]*x[2],1)}`).join(' · ')}. Итог = <b>${fmt(b.total,1)}</b>.</div><section class="section"><h3>ЧТО ОЗНАЧАЮТ ОСТАЛЬНЫЕ ПОКАЗАТЕЛИ</h3><div class="why-guide"><div class="why-guide-row"><div><b>AVG</b><span>Средние убийства за подробную карту.</span></div><strong>${fmt(avg,2)}</strong></div><div class="why-guide-row"><div><b>K / D / A</b><span>Сырые убийства, смерти и ассисты.</span></div><strong>${fmt(kmap,2)} / ${fmt(dmap,2)} / ${fmt(amap,2)}</strong></div><div class="why-guide-row"><div><b>K-D</b><span>Убийства минус смерти.</span></div><strong>${b.diff>0?'+':''}${fmt(b.diff,1)}</strong></div><div class="why-guide-row"><div><b>K/map · D/map · A/map</b><span>Средние K, D и A на подробную карту.</span></div><strong>${fmt(kmap,2)} · ${fmt(dmap,2)} · ${fmt(amap,2)}</strong></div><div class="why-guide-row"><div><b>Trend</b><span>Движение формы между отрезками: плюс означает улучшение, минус — ухудшение.</span></div><strong>${b.trend>=0?'+':''}${fmt(b.trend,1)}</strong></div><div class="why-guide-row"><div><b>Volume</b><span>Компонент объёма: больше убийств на карту повышает нормированный балл объёма.</span></div><strong>${fmt(b.volume,1)} · 10%</strong></div><div class="why-guide-row"><div><b>Result Effectiveness</b><span>В текущем Player Index эта часть представлена нормированным K/D.</span></div><strong>${fmt(b.kdScore,1)} · 35%</strong></div><div class="why-guide-row"><div><b>Map Factor</b><span>Контекст карты. В текущей формуле отдельного веса Map Factor нет, поэтому искусственно его не добавляем.</span></div><strong>контекст</strong></div></div></section></div></div>`)}
function nav(){const items=[['home','⌂','ГЛАВНАЯ'],['analytics','▥','СТАТИСТИКА'],['base','▤','МАТЧИ'],['maps','◫','КАРТЫ'],['teams','♟','СОСТАВЫ'],['records','♜','РЕКОРДЫ']];$('#nav').innerHTML=items.map(([id,ico,n])=>{const active=state.tab===id||(['players','compare','profile'].includes(state.tab)&&id==='analytics');return `<div class="nav-group"><button class="nav-btn ${active?'active':''}" data-tab="${id}"><span class="nav-icon">${ico}</span><span>${n}</span></button></div>`}).join('');document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{state.tab=b.dataset.tab;render()});$('#settingsBtn').onclick=()=>{state.tab='settings';render()}}
function render(){nav();const v=$('#view');({home,base,analytics,players,compare,maps,teams,records,settings}[state.tab]||home)(v)}
function mapStats(mapName){const ms=DB.maps.filter(m=>m.archived!==true&&m.map===mapName&&m.stats_available);let k=0,d=0,a=0,rows=0;for(const m of ms)for(const s of m.player_stats)if(s.player_id){k+=s.kills;d+=s.deaths;a+=s.assists;rows++}return{maps:DB.maps.filter(m=>m.archived!==true&&m.map===mapName).length,detailed:ms.length,k,d,a,kd:d?k/d:0,diff:k-d,rows}}
function historicalLobbyGroups(match){
  const clean=arr=>[...new Set((Array.isArray(arr)?arr:[]).filter(id=>id&&player(id)))].slice(0,5);
  const explicitA=clean(match?.team_a),explicitB=clean(match?.team_b);
  if(explicitA.length||explicitB.length)return [explicitA,explicitB];
  const knownIds=rows=>[...new Set((rows||[]).map(r=>r?.player_id).filter(id=>id&&player(id)))];
  const maps=matchMaps(match).filter(mp=>mp.stats_available).slice().sort((a,b)=>{
    const ca=knownIds(a.player_stats).length,cb=knownIds(b.player_stats).length;
    return cb-ca||Number(a.map_index||0)-Number(b.map_index||0);
  });
  const primary=maps[0]?knownIds(maps[0].player_stats):[];
  const agg=knownIds(match?.series_aggregate_stats||[]);
  const source=[...primary,...agg.filter(id=>!primary.includes(id))];
  return [source.slice(0,5),source.slice(5,10)];
}
function mapPlayerStats(id,mapName){
  const maps=DB.maps.filter(mp=>mp.archived!==true&&mp.map===mapName&&mp.stats_available);
  let played=0,wins=0,k=0,d=0,a=0;
  for(const mp of maps){
    const row=(mp.player_stats||[]).find(x=>x.player_id===id); if(!row)continue;
    const match=DB.matches.find(m=>m.match_id===mp.match_id); const [ta,tb]=historicalLobbyGroups(match);
    const side=ta.includes(id)?'A':tb.includes(id)?'B':'';
    const sa=Number(mp.score?.team_a),sb=Number(mp.score?.team_b);
    if(!side||!Number.isFinite(sa)||!Number.isFinite(sb))continue;
    played++; if((side==='A'&&sa>sb)||(side==='B'&&sb>sa))wins++;
    k+=Number(row.kills)||0; d+=Number(row.deaths)||0; a+=Number(row.assists)||0;
  }
  const kd=d?k/d:0, raw=played?wins/played:null, smooth=(wins+1)/(played+2), idx=index(id);
  // Map strength is deliberately conservative for small samples: map history is primary,
  // Player Index is a secondary stabilizer, and confidence grows with the number of maps.
  const confidence=clamp(played/10,0,1);
  const wrBase=raw==null ? 0.5 : smooth;
  const idxContext=clamp((idx-50)/50,-1,1);
  const power=clamp(50 + (wrBase-.5)*42*confidence + idxContext*8*(1-confidence*.65),0,100);
  return {played,wins,losses:Math.max(0,played-wins),wr:raw==null ? 0.5 : raw,smoothWr:smooth,k,d,a,kd,power,confidence};
}
function teamMapProbability(ids,mapName){
  const players=ids.map(id=>({id,stats:mapPlayerStats(id,mapName)}));
  if(!players.length)return{power:0,coverage:0,wr:null,confidence:0,players};
  const power=players.reduce((z,x)=>z+x.stats.power,0)/players.length;
  const played=players.reduce((z,x)=>z+x.stats.played,0),wins=players.reduce((z,x)=>z+x.stats.wins,0);
  const confidence=players.reduce((z,x)=>z+x.stats.confidence,0)/players.length;
  return{power,coverage:played,wr:played?wins/played:null,confidence,players};
}
function matchupProbability(teamA,teamB,mapName){
  const a=teamMapProbability(teamA,mapName),b=teamMapProbability(teamB,mapName),ready=teamA.length===5&&teamB.length===5;
  const delta=a.power-b.power;
  const pA=ready?1/(1+Math.pow(10,-delta/16)):.5;
  return{a,b,pA,pB:1-pA,delta,ready};
}
function mapWinRateRows(id){
  const preferred=['mirage','dust2','anubis','nuke','inferno','cache','overpass','ancient','train','vertigo'];
  const names=[...new Set(DB.maps.filter(m=>m.archived!==true).map(m=>m.map))];
  return names.map(map=>({map,...mapPlayerStats(id,map)})).sort((a,b)=>{const ia=preferred.indexOf(a.map.toLowerCase()),ib=preferred.indexOf(b.map.toLowerCase());return (ia<0?999:ia)-(ib<0?999:ib)||a.map.localeCompare(b.map)});
}
function record(metric,dir='max'){const arr=[];for(const p of activePlayers())for(const r of detailRows(p.player_id))arr.push({p:p.display_name,r,val:metric==='kills'?r.kills:metric==='kd'?(r.deaths?r.kills/r.deaths:0):r.kills-r.deaths});arr.sort((a,b)=>dir==='max'?b.val-a.val:a.val-b.val);return arr[0]}
function kdMarkup(k,d){const kd=Number(d)>0?Number(k)/Number(d):0;const cls=Math.abs(kd-1)<1e-9?'kd-neutral':kd>1?'kd-positive':'kd-negative';return `<span class="kd-value ${cls}">${fmt(kd)}</span>`}
function kdClass(k,d){const kd=Number(d)>0?Number(k)/Number(d):0;return Math.abs(kd-1)<1e-9?'kd-neutral':kd>1?'kd-positive':'kd-negative'}
function kdMarkupValue(kd,prefix=''){const n=Number(kd)||0;return `<span class="kd-value ${Math.abs(n-1)<1e-9?'kd-neutral':n>1?'kd-positive':'kd-negative'}">${prefix}${fmt(n,2)}</span>`}
function scoreClass(score){const m=String(score||'').match(/^(\d+)\s*:\s*(\d+)$/);if(!m)return 'score-neutral';const a=+m[1],b=+m[2];return a>b?'score-positive':a<b?'score-negative':'score-neutral'}
function scoreMarkup(score){const m=String(score||'').match(/^(\d+)\s*:\s*(\d+)$/);if(!m)return `<span class="score-neutral">${esc(score||'—')}</span>`;const a=Number(m[1]),b=Number(m[2]);const cls=a>b?'score-positive':a<b?'score-negative':'score-neutral';return `<span class="score-badge ${cls}">${a}:${b}</span>`}
function seriesAggregateRows(match){const maps=matchMaps(match),src=match.source_kind==='compact_bo3'?(match.series_aggregate_stats||[]):maps.flatMap(mp=>mp.stats_available?(mp.player_stats||[]):[]),by=new Map();for(const r of src){const id=r.player_id||`raw:${r.raw_name||''}`;if(!by.has(id))by.set(id,{player_id:r.player_id||null,raw_name:r.raw_name||'',kills:0,deaths:0,assists:0});const x=by.get(id);x.kills+=Number(r.kills)||0;x.deaths+=Number(r.deaths)||0;x.assists+=Number(r.assists)||0}return [...by.values()].map(x=>({...x,name:x.player_id?playerName(x.player_id):(x.raw_name||'Неопознанный игрок'),kd:x.deaths?x.kills/x.deaths:0,diff:x.kills-x.deaths})).sort((a,b)=>b.kd-a.kd||b.kills-a.kills)}
function mapMvp(mapId){const mp=DB.maps.find(x=>x.map_id===mapId);if(!mp||!mp.stats_available)return '—';const r=(mp.player_stats||[]).slice().sort((a,b)=>(b.deaths?b.kills/b.deaths:0)-(a.deaths?a.kills/a.deaths:0)||b.kills-a.kills)[0];return r?(r.player_id?playerName(r.player_id):(r.raw_name||'Игрок')):'—'}
function lobbyGroups(match){return historicalLobbyGroups(match)}
function home(v){
  const active=activePlayers();
  const ps=active.map(p=>({p,x:aggregate(p.player_id),idx:index(p.player_id),imp:impact(p.player_id),fo:form(p.player_id),st:stability(p.player_id)})).sort((a,b)=>b.idx-a.idx);
  const top=ps.slice(0,5),matches=activeMatches().slice().sort((a,b)=>matchOrder(a)-matchOrder(b)||String(a.match_id).localeCompare(String(b.match_id))),lastMatch=latestMatch(matches),lastMaps=matchMaps(lastMatch);
  const activeMaps=DB.maps.filter(x=>x.archived!==true),audit=auditLog().slice(-8).reverse(),recent=matches.slice(-6).reverse();
  const lastRows=homeLastRows(lastMatch), latestMap=lastMaps.filter(x=>x&&x.stats_available).at(-1)||lastMaps.at(-1);
  const best=lastRows.slice().sort((a,b)=>b.diff-a.diff)[0],worst=lastRows.slice().sort((a,b)=>a.diff-b.diff)[0];
  const winner=homeResult(lastMatch), latestDate=lastMatch?.played_at||lastMatch?.date||lastMatch?.created_at||'';
  const key=ps[0]||null;
  v.innerHTML=`
  <section class="home-shell home-rebuild">
    <aside class="home-left">
      <section class="panel home-panel last-match-panel">
        <div class="section-head"><div><h2>Последняя игра</h2><div class="muted">Обновляется автоматически</div></div><button class="text-link" onclick="state.tab='base';render()">Все игры ›</button></div>
        <div class="last-match-head">
          <div class="last-map-strip">${lastMaps.map(mp=>mapThumb(mp?.map||'CS2','small')).join('')}</div>
          <div class="last-match-meta"><strong>${esc(lastMaps.map(x=>x.map).join(' · ')||'Нет игры')}</strong><span>${esc(latestDate||'Дата не указана')}</span><span>${esc(lastMatch?.format||'—')}</span></div>
        </div>
        <div class="scoreline"><strong class="${winner==='win'?'score-green':winner==='loss'?'score-red':''}">${winner==='win'?'ПОБЕДА':winner==='loss'?'ПОРАЖЕНИЕ':'—'}</strong><b>${esc(lastMatch?.source_kind==='compact_bo3'?(lastMatch?.series_score||'—'):mapScoreText(latestMap))}</b>${lastMatch?.format==='BO3'?`<span class="muted">Серия ${esc(lastMatch.series_score||'—')}</span>`:''}</div>
        <div class="last-table-wrap">${lastRows.length?`<table class="home-last-table"><thead><tr><th>Игрок</th><th>K</th><th>D</th><th>A</th><th>K/D</th><th>K-D</th></tr></thead><tbody>${lastRows.map(r=>`<tr><td>${esc(r.name)}</td><td>${r.kills}</td><td>${r.deaths}</td><td>${r.assists}</td><td>${fmt(r.kd)}</td><td class="${r.diff>=0?'positive':'negative'}">${r.diff>0?'+':''}${r.diff}</td></tr>`).join('')}</tbody></table>`:'<div class="empty">Покарточной статистики нет.</div>'}</div>
        ${lastMatch?`<div class="last-match-footer"><span>Лучший: <b>${esc(best?.name||'—')}</b></span><span>Худший: <b>${esc(worst?.name||'—')}</b></span><span>Детально: <b>${lastRows.length}/10</b></span><span>Карт в серии: <b>${lastMaps.length}</b></span></div>`:''}
      </section>
      <section class="panel home-panel recent-games-panel home-recent-left"><div class="section-head"><div><h2>Последние игры</h2><div class="muted">Последние 6 · новые записи сверху</div></div><button class="text-link" onclick="state.tab='base';render()">Все ›</button></div><div class="recent-games">${recent.map(m=>{const mm=matchMaps(m),date=m.played_at||m.date||m.created_at||'Дата не указана';const sc=m.source_kind==='compact_bo3'?m.series_score:(mm.filter(x=>x.stats_available).at(-1)?mapScoreText(mm.filter(x=>x.stats_available).at(-1)):m.series_score||'—');return `<div class="recent-game click-row" onclick="openMatchDetail('${esc(m.match_id)}')">${mapThumb(mm[0]?.map||'—','small')}<div><b>${esc(mm.map(x=>x.map).join(' · '))}</b><span>${esc(m.format||'')} · ${esc(date)}</span></div><strong class="${scoreClass(sc)}">${esc(sc)}</strong><em class="${homeResult(m)==='win'?'positive':'negative'}">${homeResult(m)==='win'?'Победа':homeResult(m)==='loss'?'Поражение':'—'}</em></div>`}).join('')||'<div class="empty">Нет матчей.</div>'}</div></section>
    </aside>
    <section class="home-center">
      <section class="panel home-hero home-rebuild-hero" style="--hero-map:url('assets/maps/nuke.svg')">
        <div class="hero-copy"><div class="eyebrow">CS2 ANALYTICS</div><h1>Статистика, которая<br><strong>говорит за игру.</strong></h1><p>Матчи, карты, форма и история — в одном месте.</p></div>
        <div class="hero-counters"><div><b>${activeMaps.length}</b><span>Карт</span></div><div><b>${active.length}</b><span>Игроков</span></div><div><b>${new Set(activeMaps.map(x=>x.map)).size}</b><span>Типов карт</span></div></div>
      </section>
      <section class="home-metrics">
        <div class="panel metric-card"><div class="metric-head"><span>★</span><b>Индекс игрока</b><i>i</i></div><strong>${key?fmt(key.idx,1):'—'}</strong><div class="metric-foot"><span>${esc(key?.p.display_name||'—')}</span>${trendMarkup(key?.fo.trend)}</div></div>
        <div class="panel metric-card"><div class="metric-head"><span>✦</span><b>Импакт</b><i>i</i></div><strong>${key?fmt(key.imp,1):'—'}</strong><div class="metric-foot"><span>${esc(key?.p.display_name||'—')}</span>${trendMarkup(key?.fo.trend)}</div></div>
        <div class="panel metric-card"><div class="metric-head"><span>◎</span><b>K/D</b><i>i</i></div><strong>${key?fmt(key.x.kd):'—'}</strong><div class="metric-foot"><span>${esc(key?.p.display_name||'—')}</span>${trendMarkup(key?.fo.trend,'форма')}</div></div>
        <div class="panel metric-card"><div class="metric-head"><span>★</span><b>K-D</b><i>i</i></div><strong>${key?(key.x.kdDiff>0?'+':'')+fmt(key.x.kdDiff,0):'—'}</strong><div class="metric-foot"><span>${esc(key?.p.display_name||'—')}</span>${trendMarkup(key?.fo.trend,'форма')}</div></div>
      </section>
      <section class="panel home-chart-panel"><div class="section-head"><div><h2>Динамика показателей</h2><div class="muted">Выбери игроков и метрику</div></div><select id="homeMetric" class="control">${Object.entries(metricLabels).map(([k,n])=>`<option value="${k}">${n}</option>`).join('')}</select></div><div id="playerPicker" class="player-picker"></div><div id="focusBar" class="focus-bar"></div><div id="homeChart"></div></section>

    </section>
    <aside class="home-right">
      <section class="panel home-panel top-players-panel"><div class="section-head"><div><div class="eyebrow">ТОП PLAYERS</div><h2>Топ игроков</h2><div class="muted">По Индексу игрока</div></div><button class="text-link" onclick="state.tab='analytics';render()">Все ›</button></div>${top.map((q,i)=>`<div class="top-player-row"><strong class="place">${i+1}</strong><div><b>${esc(q.p.display_name)}</b><span>Индекс ${fmt(q.idx,1)}</span></div>${trendMarkup(q.fo.trend)}</div>`).join('')||'<div class="empty">Нет игроков.</div>'}</section>
      <section class="panel home-panel"><div class="section-head"><div><h2>Последние новости</h2><div class="muted">Автоматическая лента</div></div><button class="text-link" onclick="state.tab='settings';render()">Все ›</button></div>${homeNews(lastMatch,latestMap,audit,top).slice(0,4).map(n=>`<div class="news-item"><b>${esc(n.title)}</b><span>${esc(n.text)}</span></div>`).join('')||'<div class="empty">Пока тихо.</div>'}</section>
      <section class="panel home-info"><div class="eyebrow">CS2 ANALYTICS</div><h3>Анализируй.<br>Улучшайся.</h3><p>Смотри не только на K/D — отслеживай форму, стабильность, импакт и историю по картам.</p><div class="promo-mark">CS2 <span>ANALYTICS</span></div></section>
    </aside>
  </section>`;
  $('#homeMetric').value=state.metric;$('#homeMetric').onchange=e=>{state.metric=e.target.value;state.focused=null;drawHomeChart()};renderPlayerPicker();drawHomeChart()
}
function homeLastRows(match){
  if(!match)return[];
  if(match.source_kind==='compact_bo3')return(match.series_aggregate_stats||[]).map(s=>({name:s.player_id?playerName(s.player_id):(s.raw_name||'Неопознанный игрок'),kills:s.kills,deaths:s.deaths,assists:s.assists,kd:s.deaths?s.kills/s.deaths:0,diff:s.kills-s.deaths})).sort((a,b)=>b.diff-a.diff);
  const m=latestDetailedMap(match);
  return(m?.player_stats||[]).map(s=>({name:s.player_id?playerName(s.player_id):(s.raw_name||'Неопознанный игрок'),kills:s.kills,deaths:s.deaths,assists:s.assists,kd:s.deaths?s.kills/s.deaths:0,diff:s.kills-s.deaths})).sort((a,b)=>b.diff-a.diff);
}
function homeResult(match){if(!match)return null;const raw=String(match.series_score||'');const m=raw.match(/(\d+)\s*:\s*(\d+)/);if(!m)return null;return Number(m[1])>Number(m[2])?'win':Number(m[1])<Number(m[2])?'loss':'draw'}
function homeNews(lastMatch,lastMap,audit,top){const out=[];const visibleAudit=(audit||[]).find(x=>!/^REBUILD_|^MIGRATE_|^SYSTEM_/i.test(String(x?.action||'')));if(lastMap)out.push({title:'Новая игра в базе',text:`${lastMap.map} · ${lastMatch?.series_score||'счёт не указан'}`});if(visibleAudit)out.push({title:'Обновление статистики',text:`${visibleAudit.action} · ${visibleAudit.target}`});if(top[0])out.push({title:'Текущий лидер индекса',text:`${top[0].p.display_name} · ${fmt(top[0].idx,1)}`});if(lastMatch)out.push({title:'Последняя серия',text:`${lastMatch.map_ids.length} карт · ${lastMatch.format||'матч'}`});return out}

function lastMatchSummary(match){
  const maps=match.map_ids.map(id=>DB.maps.find(x=>x.map_id===id)).filter(Boolean);
  const compact=match.source_kind==='compact_bo3';
  if(compact){
    const rows=(match.series_aggregate_stats||[]).filter(s=>s.player_id).map(s=>({...s,name:playerName(s.player_id),diff:s.kills-s.deaths,kd:s.deaths?s.kills/s.deaths:0})).sort((a,b)=>b.diff-a.diff);
    return `<div class="mini-stats"><div class="mini-stat"><span>СЧЁТ СЕРИИ</span><strong>${esc(match.series_score||'—')}</strong></div><div class="mini-stat"><span>КАРТЫ</span><strong>${maps.length}</strong></div><div class="mini-stat"><span>ДАННЫЕ</span><strong>${rows.length}/10</strong></div><div class="mini-stat"><span>ЛУЧШИЙ K-D</span><strong>${rows[0]?esc(rows[0].name):'—'}</strong></div></div><div class="notice section">${esc(maps.map(x=>x.map).join(' · '))}. По этой серии источник хранит только сумму K/D/A серии; покарточный split намеренно не создаётся.</div>`;
  }
  const scored=maps.filter(x=>x.score).map(x=>`${x.map} ${x.score}`).join(' · ');
  const m=maps.filter(x=>x.stats_available).at(-1)||maps.at(-1), rows=(m?.player_stats||[]).map(s=>({...s,name:s.player_id?playerName(s.player_id):(s.raw_name||'Неопознанный игрок'),diff:s.kills-s.deaths,kd:s.deaths?s.kills/s.deaths:0})).sort((a,b)=>b.diff-a.diff);
  return `<div class="mini-stats"><div class="mini-stat"><span>СЧЁТ</span><strong>${esc(mapScoreText(m)||match.series_score||'—')}</strong></div><div class="mini-stat"><span>КАРТА</span><strong>${esc(m?.map||'—')}</strong></div><div class="mini-stat"><span>СТАТИСТИКА</span><strong>${rows.length}/10</strong></div><div class="mini-stat"><span>ЛУЧШИЙ K-D</span><strong>${rows[0]?esc(rows[0].name):'—'}</strong></div></div><div class="notice section">${esc(scored||'Счёт карты не указан')}</div>`;
}

function lastGameTable(){
  const match=latestMatch();
  if(!match)return'<div class="empty">Нет данных</div>';
  if(match.source_kind==='compact_bo3'){
    const rows=(match.series_aggregate_stats||[]).map(s=>({...s,name:s.player_id?playerName(s.player_id):(s.raw_name||'Неопознанный игрок'),kd:s.deaths?s.kills/s.deaths:0,diff:s.kills-s.deaths})).sort((a,b)=>b.diff-a.diff);
    return `<div class="table-wrap"><table class="data-table"><thead><tr><th>Игрок</th><th>K</th><th>D</th><th>A</th><th>K/D</th><th>K-D</th></tr></thead><tbody>${rows.map(s=>`<tr><td class="name">${esc(s.name)}</td><td>${s.kills}</td><td>${s.deaths}</td><td>${s.assists}</td><td>${fmt(s.kd)}</td><td class="${s.diff>=0?'positive':'negative'}">${s.diff>0?'+':''}${s.diff}</td></tr>`).join('')}</tbody></table></div><div class="footer-note">Серия ${esc(match.series_score||'—')} · ${esc(match.map_ids.map(id=>DB.maps.find(x=>x.map_id===id)?.map||'—').join(' · '))} · сумму K/D/A серии из источника.</div>`;
  }
  const m=latestDetailedMap(match);
  if(!m)return'<div class="empty">Нет данных по последней карте</div>';
  if(!m.stats_available)return`<div class="notice">${esc(m.map.toUpperCase())} · покарточный K/D/A отсутствует.</div>`;
  return`<div class="table-wrap"><table class="data-table"><thead><tr><th>Игрок</th><th>K</th><th>D</th><th>A</th><th>K/D</th><th>K-D</th></tr></thead><tbody>${(m.player_stats||[]).map(s=>`<tr><td class="name">${esc(s.player_id?playerName(s.player_id):(s.raw_name||'Неопознанный игрок'))}</td><td>${s.kills}</td><td>${s.deaths}</td><td>${s.assists}</td><td>${fmt(s.kills/s.deaths)}</td><td class="${s.kills-s.deaths>=0?'positive':'negative'}">${s.kills-s.deaths>0?'+':''}${s.kills-s.deaths}</td></tr>`).join('')}</tbody></table></div>`;
}

function colorFor(i,n){return `hsl(${Math.round((i*360/Math.max(n,1))+205)%360} 78% ${58-Math.min(10,i*.7)}%)`}
function renderPlayerPicker(){const box=$('#playerPicker');if(!box)return;const active=activePlayers();box.innerHTML=active.map((p)=>{const on=state.selected.includes(p.player_id),focused=state.focused===p.player_id;const i=activePlayers().findIndex(x=>x.player_id===p.player_id);return active.includes(p)?`<button class="player-chip ${on?'selected':''} ${focused?'focused':''}" onclick="togglePlayer('${p.player_id}')"><span class="chip-dot" style="background:${colorFor(i,activePlayers().length)}"></span>${esc(p.display_name)}<span class="chip-check">${on?'✓':''}</span></button>`:''}).join('')+`<button class="player-chip ghost" onclick="selectAllPlayers()">ВСЕ</button><button class="player-chip ghost" onclick="clearPlayers()">СБРОС</button>`}
function togglePlayer(id){if(state.selected.includes(id)){if(state.selected.length===1){state.focused=id;toast('Оставлен минимум один игрок')}else{state.selected=state.selected.filter(x=>x!==id);if(state.focused===id)state.focused=null}}else state.selected.push(id);render()}
function selectAllPlayers(){state.selected=activePlayers().map(p=>p.player_id);state.focused=null;render()}
function clearPlayers(){state.selected=[activePlayers()[0]?.player_id].filter(Boolean);state.focused=null;render()}
function focusPlayer(id){state.focused=state.focused===id?null:id;drawHomeChart()}
function metricValue(id,r,metric){if(!r)return 0;if(metric==='kd')return r.deaths?r.kills/r.deaths:0;if(metric==='diff')return r.kills-r.deaths;if(metric==='kills')return r.kills;if(metric==='deaths')return r.deaths;if(metric==='assists')return r.assists;if(metric==='avg'){const rows=detailRows(id);return rows.length?rows.slice(0,rows.indexOf(r)+1).reduce((z,x)=>z+x.kills,0)/(rows.indexOf(r)+1):0}if(metric==='impact')return impact(id,[r],false);if(metric==='index')return indexBreakdown(id,[r],false,true).total;if(metric==='form')return form(id,[r]).form??0;if(metric==='stability')return stability(id,[r],false).score;return 0}
function elapsedMapsFor(id,mapId){const target=DB.maps.find(m=>m.map_id===mapId);if(!target)return 0;const activeIds=new Set(activeMatches().map(m=>m.match_id));const idx=DB.maps.findIndex(m=>m.map_id===mapId);if(idx<0)return 0;let n=0;for(let i=0;i<=idx;i++){const m=DB.maps[i];if(m.archived===true||!activeIds.has(m.match_id))continue;if(m.stats_available&&m.player_stats.some(s=>s.player_id===id))n++;else if(!m.stats_available){const ma=DB.matches.find(x=>x.match_id===m.match_id);if((ma?.series_aggregate_stats||[]).some(s=>s.player_id===id))n++}}return n}function seriesFor(id,metric){const rows=detailRows(id);const out=[];for(let i=0;i<rows.length;i++){const sub=rows.slice(0,i+1),elapsed=elapsedMapsFor(id,rows[i].map_id),st=stability(id,sub,true,elapsed),fo=form(id,sub);const x=aggregate(id,sub,false);let val;if(metric==='impact')val=impact(id,sub,false);else if(metric==='index')val=index(id,sub,false);else if(metric==='form')val=fo.form??0;else if(metric==='stability')val=st.score;else val=metricValue(id,rows[i],metric);if(['kd','diff','kills','deaths','assists'].includes(metric)){if(metric==='kd')val=x.kd;if(metric==='diff')val=x.kdDiff;if(metric==='kills')val=x.k;if(metric==='deaths')val=x.d;if(metric==='assists')val=x.a}out.push({n:i+1,val,map:rows[i].map})}return out}
function drawHomeChart(){const box=$('#homeChart');if(!box)return;const metric=state.metric,ids=(state.focused?[state.focused]:state.selected).filter(Boolean);const active=activePlayers(),colors=Object.fromEntries(active.map((p,i)=>[p.player_id,colorFor(i,active.length)]));const series=ids.map(id=>({id,pts:seriesFor(id,metric)}));if(!series.some(s=>s.pts.length)){box.innerHTML='<div class="empty">Нет детальных данных для выбранных игроков.</div>';return}const W=1120,H=350,padL=54,padR=24,padT=20,padB=44,maxN=Math.max(...series.map(s=>s.pts.length)),all=series.flatMap(s=>s.pts.map(p=>p.val));let min=Math.min(...all),max=Math.max(...all);if(['index','stability','impact'].includes(metric)){min=0;max=100}else{if(metric==='kd'){min=Math.min(0,min);max=Math.max(2,max)}if(metric==='diff')min=Math.min(0,min)}if(min===max){min-=1;max+=1}const x=n=>padL+(W-padL-padR)*((n-1)/Math.max(1,maxN-1)),y=v=>H-padB-(H-padB-padT)*((v-min)/(max-min));let svg=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${metricLabels[metric]}">`;for(let i=0;i<=5;i++){const val=min+(max-min)*i/5,yy=y(val);svg+=`<line x1="${padL}" y1="${yy}" x2="${W-padR}" y2="${yy}" class="chart-grid soft"/><text x="8" y="${yy+4}" class="chart-label">${fmt(val,metric==='kd'?2:1)}</text>`}const ticks=[1,10,20,30,40,50,60].filter(n=>n<=maxN);for(const n of ticks){const xx=x(n);svg+=`<line x1="${xx}" y1="${padT}" x2="${xx}" y2="${H-padB}" class="chart-grid tick"/><text x="${xx}" y="${H-18}" text-anchor="middle" class="chart-label">${n}</text>`}svg+=`<text x="${W-padR}" y="${H-18}" text-anchor="end" class="chart-label">детальные карты</text>`;series.forEach(s=>{const pts=s.pts.map(p=>`${x(p.n)},${y(p.val)}`).join(' ');const opacity=state.focused&&state.focused!==s.id?.22:1;svg+=`<polyline points="${pts}" class="line ${state.focused===s.id?'line-focus':''}" style="stroke:${colors[s.id]};opacity:${opacity}" onclick="focusPlayer('${s.id}')"/>`;const checkpoints=s.pts.filter(p=>[10,20,30,40,50,60].includes(p.n)).map(p=>`<circle cx="${x(p.n)}" cy="${y(p.val)}" r="4" fill="${colors[s.id]}" class="checkpoint" onclick="focusPlayer('${s.id}')"><title>${esc(playerName(s.id))} · ${p.n} карт · ${metricLabels[metric]}: ${fmt(p.val,metric==='kd'?2:1)}</title></circle>`).join('');svg+=checkpoints;const last=s.pts[s.pts.length-1];svg+=`<circle cx="${x(last.n)}" cy="${y(last.val)}" r="4" fill="${colors[s.id]}" class="dot" onclick="focusPlayer('${s.id}')"><title>${esc(playerName(s.id))} · ${last.n} карт · ${metricLabels[metric]}: ${fmt(last.val,metric==='kd'?2:1)}</title></circle>`});for(const n of [10,20,30,40,50,60].filter(n=>n<=maxN)){const rows=series.map(s=>{const p=s.pts.find(x=>x.n===n);return p?`${playerName(s.id)}: ${fmt(p.val,metric==='kd'?2:1)}`:null}).filter(Boolean);if(rows.length){const xx=x(n);svg+=`<rect x="${xx-10}" y="${padT}" width="20" height="${H-padB-padT}" class="hover-zone"><title>${n} карт · ${metricLabels[metric]}\n${rows.join('\n')}</title></rect>`}}svg+='</svg>';const legend=series.map(s=>{const p=active.find(p=>p.player_id===s.id),last=s.pts.at(-1);return`<button class="legend-item ${state.focused===s.id?'active':''}" onclick="focusPlayer('${s.id}')"><i style="background:${colors[s.id]}"></i>${esc(p?.display_name||s.id)}<strong>${fmt(last.val,metric==='kd'?2:1)}</strong></button>`}).join('');box.innerHTML=`<div class="chart"><div class="chart-title-row"><strong>${metricLabels[metric]}</strong><span class="muted">1–${maxN} подробных карт · hover 10/20/30/40/50/60</span></div>${svg}<div class="legend">${legend}</div><div class="muted chart-note">Нажми на линию или игрока в легенде — фокус. Наведи на контрольную точку — сравнение на этом отрезке.</div></div>`;const fb=$('#focusBar');if(fb)fb.innerHTML=state.focused?`<span>Фокус: <strong>${esc(playerName(state.focused))}</strong></span><button class="btn mini" onclick="state.focused=null;drawHomeChart();renderPlayerPicker()">ПОКАЗАТЬ ВСЕ ВЫБРАННЫЕ</button>`:''}
function openMatchDetail(id){const m=DB.matches.find(x=>x.match_id===id);if(!m)return;const maps=matchMaps(m),rows=seriesAggregateRows(m),groups=lobbyGroups(m),isBO1=m.format==='BO1';const top=rows.slice(0,10),team=ids=>ids.map(pid=>rows.find(r=>r.player_id===pid)).filter(Boolean).sort((a,b)=>b.kd-a.kd||b.kills-a.kills);const lobby=groups[0].length||groups[1].length?`<div class="lobby-grid"><div><h3>КОМАНДА A <small>${groups[0].length}/5</small></h3>${team(groups[0]).map(r=>`<div class="lobby-row"><b>${esc(r.name)}</b><span>${r.kills}/${r.deaths}/${r.assists}</span><strong>${kdMarkup(r.kills,r.deaths)}</strong></div>`).join('')||'<div class="empty">нет игроков</div>'}</div><div><h3>КОМАНДА B <small>${groups[1].length}/5</small></h3>${team(groups[1]).map(r=>`<div class="lobby-row"><b>${esc(r.name)}</b><span>${r.kills}/${r.deaths}/${r.assists}</span><strong>${kdMarkup(r.kills,r.deaths)}</strong></div>`).join('')||'<div class="empty">нет игроков</div>'}</div></div>`:'<div class="empty">В источнике нет игроков для распределения.</div>';const mapBtns=maps.map((mp,i)=>`<button class="btn mini" onclick="openMapDetail('${esc(mp.map_id)}')">${i+1}. ${esc(mp.map)} · ${scoreMarkup(mapScoreText(mp))}</button>`).join('');document.body.insertAdjacentHTML('beforeend',`<div class="modal-back" id="modal"><div class="modal panel wide"><div class="modal-head"><div><div class="eyebrow">${esc(m.format||'МАТЧ')}</div><h2>${scoreMarkup(m.series_score||'Матч')}</h2><div class="muted">${m.played_at?esc(m.played_at):''}</div></div><button class="close" onclick="closeModal()">×</button></div>${!isBO1?`<section class="section"><div class="section-head"><h3>ТОП-10 СЕРИИ</h3><span class="muted">вся серия · K/D</span></div><div class="table-wrap"><table class="data-table"><thead><tr><th>#</th><th>Игрок</th><th>K</th><th>D</th><th>A</th><th>K/D</th></tr></thead><tbody>${top.map((r,i)=>`<tr><td>${i+1}</td><td class="name">${esc(r.name)}</td><td>${r.kills}</td><td>${r.deaths}</td><td>${r.assists}</td><td>${kdMarkup(r.kills,r.deaths)}</td></tr>`).join('')}</tbody></table></div></section>`:`<section class="section"><div class="section-head"><h3>СЧЁТ</h3><span>${scoreMarkup(maps[0]?mapScoreText(maps[0]):m.series_score)}</span></div></section>`}<section class="section"><div class="section-head"><h3>${isBO1?'КОМАНДЫ':'КАРТЫ СЕРИИ'}</h3></div><div class="toolbar">${mapBtns}</div></section><section class="section">${lobby}</section>${state.logged?`<div class="toolbar"><button class="btn" onclick="openEditMatch('${esc(id)}')">РЕДАКТИРОВАТЬ</button><button class="btn danger" onclick="deleteMatch('${esc(id)}');closeModal()">УДАЛИТЬ</button></div>`:''}</div></div>`)}
function base(v){const activeMaps=DB.maps.filter(m=>state.showArchived||m.archived!==true).map(mp=>({mp,match:DB.matches.find(x=>x.match_id===mp.match_id)})).filter(x=>x.match),activeSeries=DB.matches.filter(m=>state.showArchived||m.archived!==true),idNum=v=>{const m=String(v||'').match(/(?:_|-)(\d+)$/);return m?Number(m[1]):0},rows=activeMaps.slice().sort((a,b)=>matchOrder(b.match)-matchOrder(a)||Number(b.mp.map_index||0)-Number(a.mp.map_index||0)),seriesRows=activeSeries.slice().sort((a,b)=>matchOrder(b)-matchOrder(a)||idNum(b.match_id)-idNum(a.match_id)),isMaps=state.baseMode!=='series',trashCount=DB.matches.filter(m=>m.archived===true).length;const body=isMaps?rows.map(q=>{const mp=q.mp,m=q.match,n=activeMapNumber(mp.map_id);return `<tr class="click-row" onclick="openMapDetail('${esc(mp.map_id)}')"><td class="name">ИГРА ${n||'—'} · ${esc(mp.map)}</td><td>${esc(m.match_id)}</td><td>${esc(m.format||'—')}</td><td>${scoreMarkup(mapScoreText(mp)||m.series_score||'—')}</td>${state.logged?`<td><button class="btn mini danger" onclick="event.stopPropagation();deleteMatch('${esc(m.match_id)}')">УДАЛИТЬ</button></td>`:''}</tr>`}).join(''):seriesRows.map((m,i)=>{const maps=(m.map_ids||[]).map(id=>DB.maps.find(x=>x.map_id===id)).filter(Boolean);return `<tr class="click-row" onclick="openMatchDetail('${esc(m.match_id)}')"><td class="name">СЕРИЯ ${seriesRows.length-i}</td><td>${esc(m.format||'—')}</td><td>${maps.map(x=>esc(x.map)).join(' · ')}</td><td>${scoreMarkup(m.series_score||'—')}</td>${state.logged?`<td><button class="btn mini" onclick="event.stopPropagation();openEditMatch('${esc(m.match_id)}')">РЕДАКТИРОВАТЬ</button> <button class="btn mini danger" onclick="event.stopPropagation();deleteMatch('${esc(m.match_id)}')">УДАЛИТЬ</button></td>`:''}</tr>`}).join('');const head=isMaps?`<tr><th>ИГРА / КАРТА</th><th>СЕРИЯ</th><th>ФОРМАТ</th><th>СЧЁТ</th>${state.logged?'<th></th>':''}</tr>`:`<tr><th>СЕРИЯ</th><th>ФОРМАТ</th><th>КАРТЫ</th><th>СЧЁТ</th>${state.logged?'<th></th>':''}</tr>`;v.innerHTML=`<section class="section base-page"><div class="section-head"><div><div class="eyebrow">СТАТИСТИКА</div><h2>${isMaps?'СТАТИСТИКА ИГР':'СТАТИСТИКА СЕРИЙ'}</h2><div class="muted">${isMaps?`${rows.length} карт · ${seriesRows.length} серий.`:`${seriesRows.length} серий · ${rows.length} карт.`}</div></div><div class="toolbar"><button class="btn ${isMaps?'primary':''}" onclick="state.baseMode='maps';render()">ВСЕ ИГРЫ · ${rows.length}</button><button class="btn ${!isMaps?'primary':''}" onclick="state.baseMode='series';render()">СЕРИИ · ${seriesRows.length}</button>${state.logged?'<button class="btn primary" onclick="openAddGame()">+ ДОБАВИТЬ ИГРУ</button>':''}${state.logged?`<button class="btn" onclick="openTrash()">🗑 КОРЗИНА${trashCount?` · ${trashCount}`:''}</button>`:''}</div></div><div class="panel card"><div class="table-wrap"><table class="data-table"><thead>${head}</thead><tbody>${body||'<tr><td colspan="8"><div class="empty">Нет записей.</div></td></tr>'}</tbody></table></div></div></section>`}
function analytics(v){players(v)}
function players(v){const ps=activePlayers().map(p=>({p,x:aggregate(p.player_id),st:stability(p.player_id),fo:form(p.player_id),imp:impact(p.player_id),idx:index(p.player_id)})).sort((a,b)=>b.idx-a.idx);v.innerHTML=`<section class="section"><div class="section-head"><div><div class="eyebrow">ЦЕНТР ИГРОКОВ</div><h2>ЦЕНТР ИГРОКОВ</h2></div><div class="toolbar"><button class="btn primary" onclick="state.tab='compare';render()">СРАВНИТЬ</button></div></div><div class="panel card"><div class="table-wrap"><table class="data-table"><thead><tr><th>Игрок</th><th>Карты</th><th>K</th><th>D</th><th>A</th><th>K/D</th><th>K-D</th><th>Импакт</th><th>Форма</th><th>Стабильность</th><th>Индекс игрока</th></tr></thead><tbody>${ps.map(q=>`<tr class="click-row" onclick="openPlayerDetail('${q.p.player_id}')"><td class="name">${esc(q.p.display_name)}</td><td>${q.x.maps}</td><td>${q.x.k}</td><td>${q.x.d}</td><td>${q.x.a}</td><td>${kdMarkup(q.x.k,q.x.d)}</td><td class="${q.x.kdDiff>=0?'positive':'negative'}">${q.x.kdDiff>0?'+':''}${fmt(q.x.kdDiff,0)}</td><td>${fmt(q.imp,1)}</td><td>${fmt(q.fo.form)}</td><td>${fmt(q.st.score,1)}</td><td class="blue"><strong>${fmt(q.idx,1)}</strong></td></tr>`).join('')}</tbody></table></div></div></section>`}
function compare(v){const active=activePlayers(), selected=state.compare.filter(id=>active.some(p=>p.player_id===id));if(!selected.length)state.compare=active.slice(0,2).map(p=>p.player_id);const ids=state.compare.filter(id=>active.some(p=>p.player_id===id));const qs=ids.map(id=>({p:player(id),x:aggregate(id),idx:index(id),imp:impact(id),fo:form(id),st:stability(id)}));const metricRows=[['K/D',q=>q.x.kd,2],['AVG',q=>q.x.maps?q.x.k/q.x.maps:0,2],['K',q=>q.x.k,0],['D',q=>q.x.d,0],['A',q=>q.x.a,0],['K-D',q=>q.x.kdDiff,0],['Импакт',q=>q.imp,1],['Стабильность',q=>q.st.score,1],['Форма',q=>q.fo.form,1],['Индекс игрока',q=>q.idx,1],['Карты',q=>q.x.maps,0]];v.innerHTML=`<section class="section"><div class="section-head"><div><div class="eyebrow">СРАВНЕНИЕ ИГРОКОВ</div><h2>СРАВНЕНИЕ ИГРОКОВ</h2><div class="muted">Выбери от 1 до 5 игроков. Сравнение описывает данные базы, а не прогнозирует исход игры.</div></div><div class="toolbar"><button class="btn" onclick="state.compare=active.map(p=>p.player_id);render()">ВСЕ</button><button class="btn" onclick="state.compare=active.slice(0,2).map(p=>p.player_id);render()">СБРОС</button></div></div><div class="panel card"><div class="player-picker compare-picker">${active.map(p=>`<button class="player-chip ${ids.includes(p.player_id)?'selected':''}" onclick="toggleCompare('${p.player_id}')">${esc(p.display_name)} ${ids.includes(p.player_id)?'✓':''}</button>`).join('')}</div></div><div class="panel card section"><div class="table-wrap"><table class="data-table compare-table"><thead><tr><th>Метрика</th>${qs.map(q=>`<th>${esc(q.p.display_name)}</th>`).join('')}</tr></thead><tbody>${metricRows.map(([name,fn,n])=>`<tr><td class="name">${name}</td>${qs.map(q=>`<td>${fmt(fn(q),n)}</td>`).join('')}</tr>`).join('')}</tbody></table></div></div><div class="grid2 section"><div class="panel card"><div class="section-head"><h3>ТЕКУЩАЯ ФОРМА</h3><span class="muted">последние карты</span></div>${qs.map(q=>`<div class="compare-row"><b>${esc(q.p.display_name)}</b><span>${fmt(q.fo.form)} ${q.fo.trend>=0?'↑':'↓'} · ${q.fo.n} карт</span></div>`).join('')}</div><div class="panel card"><div class="section-head"><h3>СТАБИЛЬНОСТЬ</h3><span class="muted">разброс результата</span></div>${qs.map(q=>`<div class="compare-row"><b>${esc(q.p.display_name)}</b><span>${fmt(q.st.score,1)} · ${q.st.plus}/${q.st.detailed} подробно в плюс</span></div>`).join('')}</div></div></section>`}
function toggleCompare(id){if(state.compare.includes(id)){if(state.compare.length>1)state.compare=state.compare.filter(x=>x!==id)}else if(state.compare.length<5)state.compare.push(id);else toast('Максимум 5 игроков');render()}
function openPlayerDetail(id){const p=player(id),x=aggregate(id),st=stability(id),fo=form(id),imp=impact(id),idx=index(id),rows=detailRows(id),detailTotal=aggregate(id,rows,false),detailKd=detailTotal.d?detailTotal.k/detailTotal.d:0,avgKills=detailTotal.maps?detailTotal.k/detailTotal.maps:0;const windows=formWindows(rows);const eras=eraRows(id);const mapWinRows=mapWinRateRows(id);const latest=rows.slice().reverse().slice(0,10);const mapRows=latest.map(r=>{const n=activeMapNumber(r.map_id);return `<div class="map-history-row compact-row"><div><b class="map-history-name">${esc(r.map)}</b><span class="map-kda ${kdClass(r.kills,r.deaths)}">${r.kills}/${r.deaths}/${r.assists}</span></div><strong class="map-mvp-link">MVP · ${esc(mapMvp(r.map_id))}</strong><span class="map-history-index">${n?`#${n}`:''}</span></div>`}).join('');document.body.insertAdjacentHTML('beforeend',`<div class="modal-back" id="playerModal"><div class="modal panel wide"><div class="modal-head"><div><div class="eyebrow">ПРОФИЛЬ ИГРОКА</div><h2>${esc(p.display_name)}</h2><div class="career-summary">${detailTotal.maps} карт · ${detailTotal.k} K / ${detailTotal.d} D / ${detailTotal.a} A · K/D ${fmt(detailKd)} · AVG K ${fmt(avgKills,2)}</div></div><button class="close" onclick="closePlayerDetail()">×</button></div><div class="detail-grid"><div class="panel inset"><div class="muted">ИНДЕКС ИГРОКА</div><div class="metric blue">${fmt(idx,1)}</div><button class="btn mini why-below" onclick="openWhyIndex('${id}')">ПОЧЕМУ ${fmt(idx,1)}?</button></div><div class="panel inset"><div class="muted">ИМПАКТ</div><div class="metric">${fmt(imp,1)}</div></div><div class="panel inset"><div class="muted">СТАБИЛЬНОСТЬ</div><div class="metric">${fmt(st.score,1)}</div></div><div class="panel inset"><div class="muted">ФОРМА</div><div class="metric">${fmt(fo.form)}</div></div></div><section class="section"><div class="section-head"><h3>ФОРМА ПО ОТРЕЗКАМ</h3><span class="muted">по последним картам</span></div><div class="form-window-grid">${windows.map((w,i)=>`<div class="form-window-card ${w.n===1?'latest':''}"><span>${w.n===1?'Последняя':`Последние ${w.n}`}</span><strong>avg ${fmt(w.avg,2)}</strong><small>${kdMarkupValue(w.kd,'K/D ')}</small></div>`).join('')||'<div class="empty">Нет подробной истории.</div>'}</div></section><section class="section"><div class="section-head"><h3>ВИНРЕЙТ ПО КАРТАМ</h3><span class="muted">по доступной истории игрока</span></div><div class="map-wr-grid">${mapWinRows.map(w=>`<div class="map-wr-card"><div><b>${esc(w.map)}</b><small>${w.played} карт · ${w.wins}-${w.losses}</small></div><strong>${w.played?Math.round(w.wr*100)+'%':'—'}</strong><span>${w.played?`${fmt(w.kd,2)} K/D`:'нет игр'}</span></div>`).join('')||'<div class="empty">Нет матчей с определённым исходом.</div>'}</div></section><section class="section"><div class="section-head"><h3>ЭРЫ</h3><span class="muted">история по 10 карт</span></div><div class="era-grid">${eras.map(e=>`<div class="era-card"><span>Эра ${e.from}–${e.to}</span><strong>avg ${fmt(e.avg,2)}</strong><small>${kdMarkupValue(e.kd,'K/D ')}</small></div>`).join('')||'<div class="empty">Недостаточно подробной истории.</div>'}</div></section><section class="section"><div class="section-head"><h3>ПОСЛЕДНИЕ ПОДРОБНЫЕ КАРТЫ</h3><span class="muted">10 последних</span></div><div class="map-history">${mapRows||'<div class="empty">Нет подробной истории.</div>'}</div></section></div></div>`)}
function closePlayerDetail(){$('#playerModal')?.remove()}
function maps(v){
  const preferred=['mirage','dust2','anubis','nuke','inferno','cache','overpass','ancient','train','vertigo'];const names=[...new Set(DB.maps.filter(m=>m.archived!==true).map(m=>m.map))].sort((a,b)=>{const ia=preferred.indexOf(a.toLowerCase()),ib=preferred.indexOf(b.toLowerCase());return (ia<0?999:ia)-(ib<0?999:ib)||a.localeCompare(b)}), rows=names.map(n=>({...mapStats(n),map:n}));
  const selected=state.map==='all'?'all':(names.includes(state.map)?state.map:(names[0]||'all'));
  v.innerHTML=`<section class="section maps-page">
    <div class="section-head"><div><div class="eyebrow">ЦЕНТР КАРТ</div><h2>КАРТЫ</h2><div class="muted">Выбери карту — ниже переключаются её статистика, лаборатория и история.</div></div><div class="toolbar"><select id="mapSelect" class="control"><option value="all">Все карты</option>${names.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('')}</select></div></div>
    <div class="map-card-grid">${rows.map((r,i)=>`<button class="map-card ${r.map===selected?'selected':''}" onclick="state.map='${esc(r.map)}';render()"><div class="map-card-image" style="background-image:${mapBg(r.map)}"><img class="map-logo" src="${mapIconRemoteAsset(r.map)}" alt="" onerror="this.style.display='none'"><span>${esc(r.map.toUpperCase())}</span></div><div class="map-card-body"><div><b>${esc(r.map)}</b><small>${r.maps} игр · ${r.detailed} подробно</small></div><strong>${fmt(r.kd)}</strong></div><div class="map-card-foot"><span>K-D <b class="${r.diff>=0?'positive':'negative'}">${r.diff>0?'+':''}${r.diff}</b></span><span>${r.k} K · ${r.d} D · ${r.a} A</span></div></button>`).join('')}</div>
    <div class="panel card map-selected-head ${selected!=='all'?'has-map-atmosphere':''}" ${selected!=='all'?`style="--map-bg:url('${mapRemoteAsset(selected)}')"`:''}><div class="section-head"><div><h3>ВЫБРАННАЯ КАРТА · ${esc(selected||'—')}</h3><div class="muted">${selected==='all'?'Сводка по всем картам. Выбери карту для отдельного Map Lab.':'Карточка и все блоки ниже относятся только к выбранной карте.'}</div></div><span class="pill">${selected?mapStats(selected).maps:0} игр</span></div></div>
    <div id="mapLab" class="section"></div></section>`;
  $('#mapSelect').value=selected;
  $('#mapSelect').onchange=e=>{state.map=e.target.value;render()};
  renderMapLab(selected);
}
function renderMapLab(mapName){const box=$('#mapLab');if(!box)return;const isAll=mapName==='all',ms=DB.maps.filter(m=>m.archived!==true&&(!isAll&&m.map===mapName)).sort((a,b)=>Number(b.map_index)-Number(a.map_index)),detailed=ms.filter(m=>m.stats_available),allDetailed=DB.maps.filter(m=>m.archived!==true&&m.stats_available),scopedDetailed=isAll?allDetailed:detailed,rows=activePlayers().map(p=>{const rs=scopedDetailed.flatMap(m=>(m.player_stats||[]).filter(s=>s.player_id===p.player_id)),k=rs.reduce((z,s)=>z+Number(s.kills||0),0),d=rs.reduce((z,s)=>z+Number(s.deaths||0),0),a=rs.reduce((z,s)=>z+Number(s.assists||0),0);return{p,k,d,a,kd:d?k/d:null,n:rs.length,diff:k-d}}).filter(x=>x.n),historyMs=(isAll?DB.maps.filter(m=>m.archived!==true):ms).slice().sort((a,b)=>{const ma=DB.matches.find(x=>x.match_id===a.match_id),mb=DB.matches.find(x=>x.match_id===b.match_id);return matchOrder(mb)-matchOrder(ma)||Number(b.map_index||0)-Number(a.map_index||0)}),history=historyMs.slice(0,11).map(m=>{const n=activeMapNumber(m.map_id);return `<div class="map-history-row all-map-history-row" onclick="openMapDetail('${esc(m.map_id)}')"><div><b><span class="map-history-index">${n?`#${n}`:''}</span><span class="map-history-name">${esc(m.map)}</span></b></div><strong>${mapScoreText(m)!=='—'?scoreMarkup(mapScoreText(m)):'—'}</strong></div>`}).join('');const selectedPlayer=state.mapPlayer==='all'?'':(rows.some(x=>x.p.player_id===state.mapPlayer)?state.mapPlayer:'');box.innerHTML=`<div class="panel card map-lab-panel ${!isAll?'has-map-atmosphere':''}" ${!isAll?`style="--map-bg:url('${mapRemoteAsset(mapName)}')"`:''}><div class="section-head"><div><h3>ЛАБОРАТОРИЯ КАРТ · ${esc(isAll?'ВСЕ КАРТЫ':mapName.toUpperCase())}</h3><div class="muted">${isAll?`${allDetailed.length} подробных карт по всей базе`:`${ms.length} игр · ${detailed.length} подробно`}</div></div><div class="toolbar"><select id="mapPlayerFilter" class="control"><option value="all">Все игроки</option>${activePlayers().map(p=>`<option value="${esc(p.player_id)}">${esc(p.display_name)}</option>`).join('')}</select></div></div><div class="map-heat">${rows.sort((a,b)=>(b.kd||0)-(a.kd||0)).map(x=>`<div class="heat-row ${x.p.player_id===selectedPlayer?'selected':''}" onclick="state.mapPlayer='${esc(x.p.player_id)}';renderMapLab('${esc(mapName)}')"><span>${esc(x.p.display_name)}</span><div class="heat-bar"><i style="width:${clamp((x.kd||0)/2*100,3,100)}%"></i></div><strong>${kdMarkup(x.k,x.d)}</strong><small>${x.n} карт · ${x.diff>0?'+':''}${x.diff}</small></div>`).join('')||'<div class="empty">Нет детальных K/D/A в выбранном диапазоне.</div>'}</div>${selectedPlayer?`<section class="section selected-player-card"><div class="selected-player-copy"><span class="eyebrow">ВЫБРАННЫЙ ИГРОК</span><h3>${esc(playerName(selectedPlayer))}</h3><div class="muted">${rows.find(x=>x.p.player_id===selectedPlayer)?.n||0} подробных карт</div></div></section>`:`<section class="section notice map-all-notice"><strong>Все игроки</strong><div>Выбраны все игроки. Выберите конкретного игрока в списке, чтобы открыть его данные.</div></section>`}<div class="section"><div class="section-head"><h3>ИСТОРИЯ ${isAll?'ВСЕХ КАРТ':'КАРТЫ'}</h3><span class="muted">${historyMs.length?`#${activeMapNumber(historyMs[Math.min(10,historyMs.length-1)].map_id)||'—'}–#${activeMapNumber(historyMs[0].map_id)||'—'}`:'нет карт'}</span></div><div class="map-history">${history||'<div class="empty">Нет сыгранных карт.</div>'}</div></div></div>`;$('#mapPlayerFilter').value=selectedPlayer||'all';$('#mapPlayerFilter').onchange=e=>{state.mapPlayer=e.target.value;renderMapLab(mapName)}}
function openMapDetail(mapId){
  const m=DB.maps.find(x=>x.map_id===mapId); if(!m)return; const match=DB.matches.find(x=>x.match_id===m.match_id); const rows=(m.player_stats||[]).map(s=>({...s,name:s.player_id?playerName(s.player_id):(s.raw_name||'Неопознанный игрок'),kd:s.deaths?s.kills/s.deaths:0,diff:s.kills-s.deaths})).sort((a,b)=>b.kd-a.kd||b.kills-a.kills);
  const title=`${m.map} ${mapScoreText(m)}`;
  const body=m.stats_available?`<div class="table-wrap"><table class="data-table"><thead><tr><th>#</th><th>Игрок</th><th>K</th><th>D</th><th>A</th><th>K/D</th><th>K-D</th></tr></thead><tbody>${rows.map((r,i)=>`<tr><td>${i+1}</td><td class="name">${esc(r.name)}</td><td>${r.kills}</td><td>${r.deaths}</td><td>${r.assists}</td><td>${kdMarkup(r.kills,r.deaths)}</td><td class="${r.diff>=0?'positive':'negative'}">${r.diff>0?'+':''}${r.diff}</td></tr>`).join('')}</tbody></table></div>`:`<div class="empty">Нет покарточной статистики.</div>`;
  document.body.insertAdjacentHTML('beforeend',`<div class="modal-back" id="mapModal"><div class="modal panel wide"><div class="modal-head"><div><div class="eyebrow">ПОДРОБНОСТИ КАРТЫ</div><h2>${esc(title)}</h2><div class="muted">${esc(match?.match_id||'—')}${(match?.played_at||match?.date)?` · ${esc(match.played_at||match.date)}`:''} · ${esc(match?.format||'—')}</div></div><button class="close" onclick="$('#mapModal')?.remove()">×</button></div><div class="mini-stats"><div class="mini-stat"><span>КАРТА</span><strong>${esc(m.map)}</strong></div><div class="mini-stat"><span>СЧЁТ</span><strong>${scoreMarkup(mapScoreText(m))}</strong></div><div class="mini-stat"><span>ИГРОКОВ</span><strong>${rows.length}/10</strong></div><div class="mini-stat"><span>СТАТУС</span><strong>${m.stats_available?'ПОДРОБНЫЕ':'КОМПАКТНАЯ СЕРИЯ'}</strong></div></div><section class="section">${body}</section></div></div>`);
}
function teamComparison(){
  const calc=ids=>{const q=ids.map(id=>({id,idx:index(id),imp:impact(id),st:stability(id).score}));return{n:q.length,idx:q.reduce((z,x)=>z+x.idx,0),avgIdx:q.length?q.reduce((z,x)=>z+x.idx,0)/q.length:0,imp:q.length?q.reduce((z,x)=>z+x.imp,0)/q.length:0,st:q.length?q.reduce((z,x)=>z+x.st,0)/q.length:0,coverage:q.reduce((z,x)=>z+playedMapsFor(x.id),0)/Math.max(q.length,1)}};
  return {a:calc(state.teamA),b:calc(state.teamB)};
}
function playerPick(){
  const all=activePlayers().map(p=>({p,idx:index(p.player_id),imp:impact(p.player_id),st:stability(p.player_id).score})).sort((a,b)=>b.idx-a.idx); return all[0]||null;
}
function teamRoster(){
  return DB.players.slice().sort((a,b)=>{
    const aa=a.is_active===false?1:0,bb=b.is_active===false?1:0;
    return aa-bb || String(a.display_name||a.player_id).localeCompare(String(b.display_name||b.player_id),'ru');
  });
}
function teamAverage(ids){return ids.length?ids.reduce((z,id)=>z+index(id),0)/ids.length:0}
function teamImpactAvg(ids){return ids.length?ids.reduce((z,id)=>z+impact(id),0)/ids.length:0}
function teamStabilityAvg(ids){return ids.length?ids.reduce((z,id)=>z+stability(id).score,0)/ids.length:0}
function teams(v){
  const roster=teamRoster(), byId=new Map(roster.map(p=>[p.player_id,p]));
  state.teamA=state.teamA.filter(id=>byId.has(id)); state.teamB=state.teamB.filter(id=>byId.has(id));
  state.teamA=state.teamA.filter((id,i,a)=>!state.teamB.includes(id)||a.indexOf(id)===i);
  state.teamB=state.teamB.filter((id,i,a)=>!state.teamA.includes(id)||a.indexOf(id)===i);
  const allSelected=[...state.teamA,...state.teamB], pool=roster.filter(p=>!allSelected.includes(p.player_id));
  const cmp={a:{avgIdx:teamAverage(state.teamA),imp:teamImpactAvg(state.teamA),st:teamStabilityAvg(state.teamA)},b:{avgIdx:teamAverage(state.teamB),imp:teamImpactAvg(state.teamB),st:teamStabilityAvg(state.teamB)}};
  const mapNames=[...new Set(DB.maps.filter(m=>m.archived!==true).map(m=>m.map))];if(!mapNames.includes(state.teamMap))state.teamMap=mapNames[0]||'mirage';const prob=matchupProbability(state.teamA,state.teamB,state.teamMap);const diff=Math.abs(cmp.a.avgIdx-cmp.b.avgIdx);
  const out=state.whatIfOut&&allSelected.includes(state.whatIfOut)?state.whatIfOut:(allSelected[0]||'');
  const inc=state.whatIfIn&&pool.some(p=>p.player_id===state.whatIfIn)?state.whatIfIn:(pool[0]?.player_id||'');
  state.whatIfOut=out; state.whatIfIn=inc;
  const before=teamAverage(allSelected), after=out&&inc?before+(index(inc)-index(out))/Math.max(allSelected.length,1):before, delta=after-before;
  const rosterRows=roster.filter(p=>!state.teamA.includes(p.player_id)&&!state.teamB.includes(p.player_id)).map(p=>{
    return `<div class="roster-player ${p.is_active===false?'archived':''}" draggable="true" ondragstart="dragRoster(event,'${esc(p.player_id)}')" ondragend="clearTeamDrag()"><div><b>${esc(p.display_name)}</b><span>СВОБОДЕН${p.is_active===false?' · КИКНУТ / АРХИВ':''}</span></div><strong>${fmt(index(p.player_id),1)}</strong></div>`;
  }).join('');
  const teamSlot=(id,i,t)=>id?teamRow({p:player(id),idx:index(id),imp:impact(id),st:stability(id).score},i,t):`<div class="team-slot-empty" ondragover="event.preventDefault();this.classList.add('drag-over')" ondragleave="this.classList.remove('drag-over')" ondrop="dropTeamSlot(event,'${t}',${i})"><span>${i+1}</span><b>Перетащи игрока сюда</b></div>`;
  const teamA=[0,1,2,3,4].map(i=>teamSlot(state.teamA[i],i,'A')).join('');
  const teamB=[0,1,2,3,4].map(i=>teamSlot(state.teamB[i],i,'B')).join('');
  v.innerHTML=`<section class="section teams-page"><div class="section-head"><div><div class="eyebrow">СОСТАВ 5×5</div><h2>СОСТАВЫ</h2><div class="muted">10 пустых слотов. Собери оба состава полностью сам: игроки из базы и архивные игроки доступны для перетаскивания.</div></div><div class="toolbar"><button class="btn" onclick="randomTeams()">СЛУЧАЙНО</button><button class="btn primary" onclick="balanceTeams()">БАЛАНС</button><button class="btn" onclick="state.teamA=[];state.teamB=[];state.teamChange=null;render()">ОЧИСТИТЬ</button></div></div>
<div class="team-builder-grid"><div class="panel card team-dropzone" ondragover="event.preventDefault();this.classList.add('drag-over')" ondragleave="this.classList.remove('drag-over')" ondrop="dropTeam(event,'A')"><div class="team-head"><div><h3>КОМАНДА A</h3><span class="muted">${state.teamA.length}/5 игроков</span></div><strong>${fmt(cmp.a.avgIdx,1)}</strong></div>${teamA}<div class="team-summary"><span>AVG ИНДЕКС</span><b>${fmt(cmp.a.avgIdx,1)}</b><span>Импакт</span><b>${fmt(cmp.a.imp,1)}</b><span>Стабильность</span><b>${fmt(cmp.a.st,1)}</b></div></div>
  <div class="panel card team-dropzone" ondragover="event.preventDefault();this.classList.add('drag-over')" ondragleave="this.classList.remove('drag-over')" ondrop="dropTeam(event,'B')"><div class="team-head"><div><h3>КОМАНДА B</h3><span class="muted">${state.teamB.length}/5 игроков</span></div><strong>${fmt(cmp.b.avgIdx,1)}</strong></div>${teamB}<div class="team-summary"><span>AVG ИНДЕКС</span><b>${fmt(cmp.b.avgIdx,1)}</b><span>Импакт</span><b>${fmt(cmp.b.imp,1)}</b><span>Стабильность</span><b>${fmt(cmp.b.st,1)}</b></div></div></div><div class="panel card team-probability"><div class="section-head"><div><h3>ПРОГНОЗ НА КАРТЕ</h3><div class="muted">теоретическая оценка состава по истории игроков</div></div><select id="teamMapSelect" class="control">${mapNames.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('')}</select></div><div class="prob-bars"><div class="prob-side prob-a"><strong>${prob.ready?Math.round(prob.pA*100):'—'}%</strong><span>КОМАНДА A</span><small>${prob.a.coverage?`WR ${Math.round(prob.a.wr*100)}% · ${prob.a.coverage} карт`:'нет истории'}</small></div><div class="prob-track"><i style="width:${prob.ready?Math.round(prob.pA*100):50}%"></i></div><div class="prob-side prob-b"><strong>${prob.ready?Math.round(prob.pB*100):'—'}%</strong><span>КОМАНДА B</span><small>${prob.b.coverage?`WR ${Math.round(prob.b.wr*100)}% · ${prob.b.coverage} карт`:'нет истории'}</small></div></div><div class="prob-meta"><span>${esc(state.teamMap)} · сила A ${fmt(prob.a.power,1)} · сила B ${fmt(prob.b.power,1)}</span><span>${prob.ready?'теория состава':'собери 5×5'}</span></div></div>
  <div class="grid3 section"><div class="panel card"><h3>СРАВНЕНИЕ</h3><div class="mini-stats"><div class="mini-stat"><span>ИНДЕКС A</span><strong>${fmt(cmp.a.avgIdx,1)}</strong></div><div class="mini-stat"><span>ИНДЕКС B</span><strong>${fmt(cmp.b.avgIdx,1)}</strong></div><div class="mini-stat"><span>РАЗНИЦА</span><strong>${fmt(diff,1)}</strong></div></div>${state.teamChange?.beforeA!=null?`<div class="team-change"><b>Последний свап</b><span>${esc(playerName(state.teamChange.from))} ↔ ${esc(playerName(state.teamChange.to))}</span><em>A ${fmt(state.teamChange.beforeA,1)} → ${fmt(state.teamChange.afterA,1)} · B ${fmt(state.teamChange.beforeB,1)} → ${fmt(state.teamChange.afterB,1)}</em></div>`:''}</div>
  <div class="panel card"><h3>ЧТО ЕСЛИ</h3><div class="two"><div class="field"><label>ЗАМЕНИТЬ</label><select id="whatIfOut" class="control">${allSelected.map(id=>`<option value="${esc(id)}">${esc(playerName(id))}</option>`).join('')||'<option value="">Нет игроков</option>'}</select></div><div class="field"><label>НА</label><select id="whatIfIn" class="control">${pool.map(p=>`<option value="${esc(p.player_id)}">${esc(p.display_name)}</option>`).join('')||'<option value="">Нет свободных игроков</option>'}</select></div></div><div class="mini-stats"><div class="mini-stat"><span>ДО</span><strong>${fmt(before,1)}</strong></div><div class="mini-stat"><span>ПОСЛЕ</span><strong>${fmt(after,1)}</strong></div><div class="mini-stat"><span>ИЗМЕНЕНИЕ</span><strong class="${delta>=0?'positive':'negative'}">${delta>0?'+':''}${fmt(delta,1)}</strong></div></div></div>
  <div class="panel card"><h3>ВСЕ ИГРОКИ</h3><div class="footer-note">Перетаскивай любого игрока — даже кикнутого/архивного — в пустой слот или прямо на другого игрока для свапа.</div><div class="roster-list">${rosterRows}</div></div></div></section>`;
  if($('#whatIfOut'))$('#whatIfOut').value=state.whatIfOut;
  if($('#whatIfIn'))$('#whatIfIn').value=state.whatIfIn;
  $('#whatIfOut')?.addEventListener('change',e=>{state.whatIfOut=e.target.value;render()});
  $('#whatIfIn')?.addEventListener('change',e=>{state.whatIfIn=e.target.value;render()});$('#teamMapSelect')?.addEventListener('change',e=>{state.teamMap=e.target.value;render()});if($('#teamMapSelect'))$('#teamMapSelect').value=state.teamMap;
}
function teamRow(x,i,t){if(!x||!x.p)return'';const ms=mapPlayerStats(x.p.player_id,state.teamMap||'mirage');return`<div class="team-row draggable-player" draggable="true" data-player="${esc(x.p.player_id)}" data-team="${t}" ondragover="event.preventDefault();this.classList.add('drag-over')" ondragleave="this.classList.remove('drag-over')" ondrop="dropTeamPlayer(event,'${esc(x.p.player_id)}','${t}');this.classList.remove('drag-over')" ondragstart="dragTeam(event,'${esc(x.p.player_id)}','${t}')" ondragend="clearTeamDrag()"><span class="rank">${i+1}</span><div><div class="name">${esc(x.p.display_name)}</div><div class="muted">Импакт ${fmt(x.imp,1)} · Стабильность ${fmt(x.st,1)}</div><div class="team-map-stat">${esc(state.teamMap||'map')} · ${ms.played?Math.round(ms.wr*100)+'% WR · '+ms.played+' карт':'нет истории'}</div></div><strong>${fmt(x.idx,1)}</strong><button class="close team-remove" onclick="event.stopPropagation();removeFromTeam('${esc(x.p.player_id)}','${t}')">×</button></div>`}
function addToTeam(id){const fromA=state.teamA.includes(id),fromB=state.teamB.includes(id);if(fromA||fromB)return; if(state.teamA.length<5)state.teamA.push(id);else if(state.teamB.length<5)state.teamB.push(id);else toast('Оба состава уже заполнены');render()}
function removeFromTeam(id,t){const key=t==='A'?'teamA':'teamB';state[key]=state[key].filter(x=>x!==id);render()}
function dragTeam(e,id,t){e.dataTransfer.setData('text/plain',JSON.stringify({id,t}));e.dataTransfer.effectAllowed='move';document.querySelectorAll('.team-dropzone').forEach(x=>x.classList.add('drag-ready'))}
function dragRoster(e,id){e.dataTransfer.setData('text/plain',JSON.stringify({id,t:'ROSTER'}));e.dataTransfer.effectAllowed='move';document.querySelectorAll('.team-dropzone').forEach(x=>x.classList.add('drag-ready'))}
function dropTeamPlayer(e,targetId,targetTeam){e.preventDefault();e.stopPropagation();clearTeamDrag();let data;try{data=JSON.parse(e.dataTransfer.getData('text/plain'))}catch{return}if(!data?.id||data.id===targetId)return;const beforeA=teamAverage(state.teamA),beforeB=teamAverage(state.teamB);if(data.t==='ROSTER'){const fromA=state.teamA.indexOf(data.id),fromB=state.teamB.indexOf(data.id);if(fromA>=0)state.teamA.splice(fromA,1);if(fromB>=0)state.teamB.splice(fromB,1);const to=targetTeam==='A'?state.teamA:state.teamB;const old=to.indexOf(targetId);if(old>=0)to[old]=data.id;else if(to.length<5)to.push(data.id);else return toast('Команда заполнена');}else{const from=data.t==='A'?'teamA':'teamB',to=targetTeam==='A'?'teamA':'teamB';const i1=state[from].indexOf(data.id),i2=state[to].indexOf(targetId);if(i1<0||i2<0)return;state[from][i1]=targetId;state[to][i2]=data.id;}
const afterA=teamAverage(state.teamA),afterB=teamAverage(state.teamB);state.teamChange={from:data.id,to:targetId,beforeA,beforeB,afterA,afterB};toast(`${playerName(data.id)} ↔ ${playerName(targetId)}`);render()}
function dropTeamSlot(e,targetTeam,indexSlot){e.preventDefault();clearTeamDrag();let data;try{data=JSON.parse(e.dataTransfer.getData('text/plain'))}catch{return}if(!data?.id)return;const target=targetTeam==='A'?state.teamA:state.teamB;const beforeA=teamAverage(state.teamA),beforeB=teamAverage(state.teamB);let fromA=state.teamA.indexOf(data.id),fromB=state.teamB.indexOf(data.id);if(fromA>=0)state.teamA.splice(fromA,1);if(fromB>=0)state.teamB.splice(fromB,1);const targetExisting=target[indexSlot];if(targetExisting&&targetExisting!==data.id){if(target.length>=5){if(targetExisting)target[indexSlot]=data.id; if(data.t==='A')state.teamA.push(targetExisting); else if(data.t==='B')state.teamB.push(targetExisting); else state.teamB.length<5?state.teamB.push(targetExisting):state.teamA.push(targetExisting);}else target[indexSlot]=data.id}else{if(target.length>=5)return toast('Команда заполнена');target.splice(Math.min(indexSlot,target.length),0,data.id)}
state.teamA=state.teamA.slice(0,5);state.teamB=state.teamB.slice(0,5);state.teamChange={from:data.id,to:targetExisting||null,beforeA,beforeB,afterA:teamAverage(state.teamA),afterB:teamAverage(state.teamB)};toast(`${playerName(data.id)} добавлен в команду ${targetTeam}`);render()}
function clearTeamDrag(){document.querySelectorAll('.team-dropzone,.team-slot-empty,.team-row').forEach(x=>x.classList.remove('drag-ready','drag-over'))}
function dropTeam(e,target){e.preventDefault();clearTeamDrag();let data;try{data=JSON.parse(e.dataTransfer.getData('text/plain'))}catch{return}if(!data?.id)return;const to=target==='A'?'teamA':'teamB',fromA=state.teamA.indexOf(data.id),fromB=state.teamB.indexOf(data.id);if(state[to].includes(data.id))return;if(state[to].length>=5)return toast('Команда заполнена — используй пустой слот или перетащи на игрока');if(fromA>=0)state.teamA.splice(fromA,1);if(fromB>=0)state.teamB.splice(fromB,1);state[to].push(data.id);state.teamChange={from:data.id,to:null,beforeA:null,beforeB:null,afterA:null,afterB:null};toast(`${playerName(data.id)} перемещён в команду ${target}`);render()}
function randomTeams(){const ids=teamRoster().map(p=>p.player_id).sort(()=>Math.random()-.5).slice(0,10);state.teamA=ids.slice(0,5);state.teamB=ids.slice(5,10);render()}
function balanceTeams(){const arr=teamRoster().map(p=>({id:p.player_id,v:index(p.player_id)})).sort((a,b)=>b.v-a.v).slice(0,10);let A=[],B=[],sa=0,sb=0;for(const x of arr){if(A.length<5&&(sa<=sb||B.length>=5)){A.push(x.id);sa+=x.v}else{B.push(x.id);sb+=x.v}}state.teamA=A;state.teamB=B;render()}
function recordRows(){
  const rows=[];
  for(const p of activePlayers()) for(const r of detailRows(p.player_id)) rows.push({player:p.display_name,playerId:p.player_id,map:r.map,k:r.kills,d:r.deaths,a:r.assists,kd:r.deaths?r.kills/r.deaths:0,diff:r.kills-r.deaths,impact:impact(p.player_id,[r],false),idx:indexBreakdown(p.player_id,[r],false,true).total,mapId:r.map_id,kind:'detailed',matchId:r.match_id});
  for(const m of activeMatches().filter(x=>x.source_kind==='compact_bo3')) for(const s of (m.series_aggregate_stats||[])){const p=player(s.player_id);if(!p)continue;rows.push({player:p.display_name,playerId:p.player_id,map:`BO3 · ${m.match_id}`,k:s.kills,d:s.deaths,a:s.assists,kd:s.deaths?s.kills/s.deaths:0,diff:s.kills-s.deaths,impact:impact(p.player_id,[{kills:s.kills,deaths:s.deaths,assists:s.assists}],false),idx:indexBreakdown(p.player_id,[{kills:s.kills,deaths:s.deaths,assists:s.assists}],false,true).total,mapId:null,kind:'bo3',matchId:m.match_id,playedAt:m.played_at,seriesScore:m.series_score});}
  return rows;
}
function careerRecordRows(){
  return activePlayers().map(p=>{const x=aggregate(p.player_id),imp=impact(p.player_id),idx=index(p.player_id);return{player:p.display_name,playerId:p.player_id,map:`Карьера · ${x.maps} карт`,k:x.k,d:x.d,a:x.a,kd:x.kd,diff:x.kdDiff,impact:imp,idx,mapId:null,kind:'career'}}).filter(r=>r.k||r.d||r.a).sort((a,b)=>b.idx-a.idx);
}
function bo3RecordRows(){
  const rows=[];
  for(const m of activeMatches().filter(x=>x.format==='BO3')){
    const grouped=new Map();
    if(m.source_kind==='compact_bo3'){
      for(const s of (m.series_aggregate_stats||[])){
        if(!s.player_id) continue;
        grouped.set(s.player_id,{k:Number(s.kills)||0,d:Number(s.deaths)||0,a:Number(s.assists)||0});
      }
    }else{
      for(const mid of (m.map_ids||[])){
        const mp=DB.maps.find(x=>x.map_id===mid);
        for(const s of (mp?.player_stats||[])){
          if(!s.player_id) continue;
          const g=grouped.get(s.player_id)||{k:0,d:0,a:0};
          g.k+=Number(s.kills)||0; g.d+=Number(s.deaths)||0; g.a+=Number(s.assists)||0; grouped.set(s.player_id,g);
        }
      }
    }
    for(const [pid,g] of grouped){
      const p=player(pid); if(!p) continue;
      const one=[{kills:g.k,deaths:g.d,assists:g.a}];
      rows.push({player:p.display_name,playerId:pid,map:`BO3 · ${m.match_id}`,k:g.k,d:g.d,a:g.a,kd:g.d?g.k/g.d:0,diff:g.k-g.d,impact:impact(pid,one,false),idx:indexBreakdown(pid,one,false,true).total,mapId:null,kind:'bo3',matchId:m.match_id,playedAt:m.played_at,seriesScore:m.series_score});
    }
  }
  return rows.sort((a,b)=>matchTime(activeMatches().find(m=>m.match_id===b.matchId))-matchTime(activeMatches().find(m=>m.match_id===a.matchId))||String(a.player).localeCompare(String(b.player),'ru'));
}
function bo1RecordRows(){return recordRows().filter(r=>r.kind==='detailed'&&DB.matches.find(m=>m.match_id===r.matchId)?.format==='BO1').sort((a,b)=>matchTime(DB.matches.find(m=>m.match_id===b.matchId))-matchTime(DB.matches.find(m=>m.match_id===a.matchId))||b.kd-a.kd)}
function records(v){
  const filter=state.recordFilter||'career',metric=state.recordMetric||'kills';
  const maps=[...new Set(DB.maps.filter(m=>m.archived!==true).map(m=>m.map))];
  let source;
  if(filter==='career') source=careerRecordRows();
  else if(filter==='bo1') source=bo1RecordRows();
  else if(filter==='bo3') source=bo3RecordRows();
  else if(filter==='match'){const m=latestMatch();source=m?(m.source_kind==='compact_bo3'?bo3RecordRows().filter(r=>r.matchId===m.match_id):recordRows().filter(r=>r.matchId===m.match_id)):[]}
  else if(filter==='map')source=state.recordMap&&state.recordMap!=='all'?recordRows().filter(r=>r.kind==='detailed'&&r.map===state.recordMap):recordRows().filter(r=>r.kind==='detailed');
  else source=recordRows().filter(r=>r.kind==='detailed');
  const key=metric==='kd'?'kd':metric==='diff'?'diff':metric==='assists'?'a':metric==='deaths'?'d':metric==='impact'?'impact':metric==='index'?'idx':'k';
  const sorted=source.slice().sort((a,b)=>(b[key]??0)-(a[key]??0)||String(a.player).localeCompare(String(b.player),'ru')).slice(0,10);
  const label=filter==='match'?'последний матч':filter==='map'?'выбранная карта':filter==='bo3'?'серии BO3':filter==='bo1'?'BO1':filter==='career'?'карьера':'подробные карты';
  const block=(title,arr,val)=>`<div class="panel card record-block"><div class="section-head"><h3>${title}</h3><span class="muted">ТОП 10 · ${label}</span></div>${arr.map((r,i)=>`<div class="record-row click-row" onclick="${r.matchId?`openMatchDetail('${esc(r.matchId)}')`:r.mapId?`openMapDetail('${esc(r.mapId)}')`:`openPlayerDetail('${esc(r.playerId)}')`}"><strong>${i+1}</strong><span><b>${esc(r.player)}</b><small>${esc(r.map)}${r.kind==='bo3'?` · СЕРИЯ ${esc(r.seriesScore||'BO3')} · нажми для полного лобби`:''}</small></span><em>${val(r)}</em></div>`).join('')||'<div class="empty">Нет данных для выбранного фильтра.</div>'}</div>`;
  const maxK=source.slice().sort((a,b)=>b.k-a.k).slice(0,10),bestKD=source.slice().sort((a,b)=>b.kd-a.kd).slice(0,10),bestDiff=source.slice().sort((a,b)=>b.diff-a.diff).slice(0,10),bestA=source.slice().sort((a,b)=>b.a-a.a).slice(0,10),bestImpact=source.slice().sort((a,b)=>b.impact-a.impact).slice(0,10),bestIndex=source.slice().sort((a,b)=>b.idx-a.idx).slice(0,10);
  v.innerHTML=`<section class="section records-page"><div class="section-head"><div><div class="eyebrow">ЦЕНТР РЕКОРДОВ</div><h2>РЕКОРДЫ</h2><div class="muted">Каждый режим строит свой собственный рейтинг: карьера, отдельная BO3-серия, последний матч или конкретная карта.</div></div><div class="toolbar"><select id="recordFilter" class="control"><option value="career">КАРЬЕРА</option><option value="bo1">BO1</option><option value="bo3">BO3 СЕРИИ</option><option value="match">ПОСЛЕДНИЙ МАТЧ</option><option value="map">КАРТА</option></select><select id="recordMetric" class="control"><option value="kills">УБИЙСТВА</option><option value="deaths">СМЕРТИ</option><option value="kd">K/D</option><option value="diff">K-D</option><option value="assists">ASSISTS</option><option value="impact">ИМПАКТ</option><option value="index">ИНДЕКС ИГРОКА</option></select><select id="recordMap" class="control"><option value="all">Все карты</option>${maps.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join('')}</select></div></div><div class="panel card section"><div class="section-head"><h3>ВЫБРАННЫЙ РЕКОРД · ${metric==='impact'?'ИМПАКТ':metric==='index'?'ИНДЕКС ИГРОКА':metric.toUpperCase()}</h3><span class="muted">${source.length} записей</span></div>${block('ТОП 10',sorted,r=>metric==='kd'?kdMarkup(r.k,r.d):metric==='diff'?(r.diff>0?'+':'')+fmt(r.diff,0):metric==='assists'?r.a:metric==='deaths'?r.d:metric==='impact'?fmt(r.impact,1):metric==='index'?fmt(r.idx,1):r.k)}</div><div class="records-grid">${block('МАКСИМУМ УБИЙСТВ',maxK,r=>r.k)}${block('МАКСИМУМ СМЕРТЕЙ',source.slice().sort((a,b)=>b.d-a.d).slice(0,10),r=>r.d)}${block('ЛУЧШИЙ K/D',bestKD,r=>kdMarkup(r.k,r.d))}${block('ЛУЧШИЙ K-D',bestDiff,r=>(r.diff>0?'+':'')+fmt(r.diff,0))}${block('МАКСИМУМ ASSISTS',bestA,r=>r.a)}${block('ЛУЧШИЙ ИМПАКТ',bestImpact,r=>fmt(r.impact,1))}${block('ЛУЧШИЙ ИНДЕКС',bestIndex,r=>fmt(r.idx,1))}</div></section>`;
  $('#recordFilter').value=filter;$('#recordMetric').value=metric;$('#recordMap').value=state.recordMap||'all';
  $('#recordFilter').onchange=e=>{state.recordFilter=e.target.value;if(e.target.value!=='map')state.recordMap='all';render()};
  $('#recordMetric').onchange=e=>{state.recordMetric=e.target.value;render()};
  $('#recordMap').onchange=e=>{state.recordMap=e.target.value;if(e.target.value!=='all')state.recordFilter='map';render()};
}
async function login(){const u=($('#loginUser')?.value||'').trim(),pw=$('#loginPass')?.value||'',msg=$('#loginError');if(state.cloudMode){try{await CS2Cloud.signIn(u,pw);state.logged=true;state.cloudAdmin=true;if(msg)msg.remove();toast('Авторизация успешна');render()}catch(e){if(msg){msg.textContent=e?.message||'Не удалось войти';msg.hidden=false}else toast(e?.message||'Не удалось войти');$('#loginPass')?.focus();$('#loginPass')?.select?.()}return}if(state.serverSync){state.logged=true;state.cloudAdmin=false;if(msg)msg.remove();toast('Локальная админка открыта');render();return}if(msg){msg.textContent='Для изменений запусти общий сервер или настрой Supabase Auth';msg.hidden=false}else toast('Для изменений запусти общий сервер или настрой Supabase Auth')}
function settings(v){document.getElementById('toast')?.classList.remove('show');state.teamChange=null;state.whatIfOut='';state.whatIfIn='';if(!state.logged){if(state.serverSync&&!state.cloudMode){v.innerHTML=`<div class="panel login"><div class="eyebrow">АДМИН</div><h2>Локальная админка</h2><p class="muted">Экземпляр работает через локальный/общий сервер. Отдельный пароль здесь не используется: доступ ограничивается самим сервером.</p><button class="btn primary" onclick="login()">ОТКРЫТЬ АДМИНКУ</button></div>`;return}v.innerHTML=`<div class="panel login"><div class="eyebrow">АДМИН</div><h2>Вход администратора</h2><div class="field"><label>EMAIL</label><input id="loginUser" autocomplete="username"></div><div class="field"><label>ПАРОЛЬ</label><input id="loginPass" type="password" autocomplete="current-password"></div><button class="btn primary" onclick="login()">ВОЙТИ</button><div id="loginError" class="login-error" role="alert" hidden>Не удалось войти.</div><div class="footer-note">В облачном режиме вход проверяется через Supabase Auth и список администраторов.</div></div>`;const loginUser=$('#loginUser'),loginPass=$('#loginPass');[loginUser,loginPass].forEach(el=>el?.addEventListener('keydown',e=>{if(e.key==='Enter')login()}));return}const al=auditLog().slice(-12).reverse();v.innerHTML=`<section class="section"><div class="section-head"><h2>⚙ НАСТРОЙКИ / АДМИН</h2><button class="btn" onclick="(state.cloudMode?CS2Cloud.signOut():Promise.resolve()).finally(()=>{state.logged=false;state.cloudAdmin=false;render()})">ВЫЙТИ</button></div><div class="grid2"><div class="panel card"><h3>БАЗА</h3><p class="muted">Игроки: ${activePlayers().length} · Матчи: ${activeMatches().length} · Карты: ${DB.maps.filter(m=>m.archived!==true).length}</p><div class="toolbar"><button class="btn primary" onclick="openAddGame()">+ ДОБАВИТЬ ИГРУ</button><button class="btn" onclick="openPlayerAdmin()">ИГРОКИ / ПСЕВДОНИМЫ</button><button class="btn" onclick="openTrash()">🗑 КОРЗИНА${DB.matches.filter(m=>m.archived===true).length?` · ${DB.matches.filter(m=>m.archived===true).length}`:''}</button></div><div class="field"><label>РЕЗЕРВНАЯ КОПИЯ</label><div class="toolbar"><button class="btn" onclick="exportBackup()">ЭКСПОРТ</button><label class="btn">ИМПОРТ<input type="file" accept="application/json" hidden onchange="importBackup(this.files[0])"></label></div></div></div><div class="panel card"><h3>ПРАВИЛА</h3><div class="notice">Исторические игроки архивируются, а не удаляются. Компактная BO3 сохраняет только series сумму K/D/A серии. Derived показатели пересчитываются из активной базы.</div></div></div><div class="panel card section"><div class="section-head"><h3>ИСТОРИЯ ИЗМЕНЕНИЙ</h3><span class="muted">последние ${al.length}</span></div>${al.length?al.map(x=>`<div class="news-item"><b>${esc(x.action)} · ${esc(x.target)}</b><span>${esc(x.at)} · ${esc(JSON.stringify(x.detail))}</span></div>`).join(''):'<div class="empty">История пока пуста.</div>'}</div></section>`}
function openPlayerAdmin(){const rows=DB.players.map(p=>`<div class="team-row"><div><div class="name">${esc(p.display_name)} ${p.is_active===false?'<span class="pill">архив</span>':''}</div><div class="muted">${esc(p.player_id)} · aliases: ${(p.aliases||[]).length}</div></div><div class="toolbar"><button class="btn mini" onclick="editPlayer('${p.player_id}')">ИЗМЕНИТЬ</button>${p.is_active===false?`<button class="btn mini" onclick="restorePlayer('${p.player_id}')">ВОССТАНОВИТЬ</button>`:`<button class="btn mini danger" onclick="archivePlayer('${p.player_id}')">АРХИВ</button>`}</div></div>`).join('');$('#view').insertAdjacentHTML('beforeend',`<div class="modal-back" id="modal"><div class="modal panel wide"><div class="modal-head"><h2>Игроки и алиасы</h2><button class="close" onclick="closeModal()">×</button></div><div class="grid2"><div><h3>ИГРОКИ</h3>${rows}</div><div><h3>ДОБАВИТЬ ИГРОКА</h3><div class="field"><label>ID ИГРОКА</label><input id="newPid" placeholder="player_new"></div><div class="field"><label>ОТОБРАЖАЕМОЕ ИМЯ</label><input id="newPname" placeholder="Новый игрок"></div><div class="field"><label>ПСЕВДОНИМ</label><input id="newAlias" placeholder="raw nickname"></div><button class="btn primary" onclick="savePlayerAdmin()">СОЗДАТЬ</button></div></div></div></div>`)}
function savePlayerAdmin(){const id=$('#newPid').value.trim(),name=$('#newPname').value.trim(),alias=$('#newAlias').value.trim();if(!id||!name)return toast('Нужны player_id и display name');if(!/^[\p{L}\p{N}_.: -]{1,64}$/u.test(id))return toast('player_id: буквы, цифры, пробел, _, ., :, - (до 64 символов)');if(DB.players.some(p=>p.player_id===id))return toast('Такой player_id уже есть');if(alias&&DB.aliases[alias])return toast('Этот alias уже привязан к другому игроку');const p={player_id:id,display_name:name,aliases:alias?[alias]:[],is_active:true,deletion_policy:'archive_if_historical',history_locked:false,created_at:new Date().toISOString(),updated_at:new Date().toISOString()};const a=additions();a.push({kind:'player',player:p},{kind:'aliases',aliases:alias?{[alias]:id}:{}});try{persistChange(a,{action:'CREATE_PLAYER',target:id,detail:{display_name:name,alias}})}catch(e){return toast('Не удалось сохранить игрока: хранилище браузера переполнено. Данные не изменены.')}DB.players.push(p);if(alias)DB.aliases[alias]=id;closeModal();toast('Игрок создан');render()}
function editPlayer(id){const p=player(id);if(!p)return;closeModal();$('#view').insertAdjacentHTML('beforeend',`<div class="modal-back" id="modal"><div class="modal panel"><div class="modal-head"><h2>Редактировать игрока</h2><button class="close" onclick="closeModal()">×</button></div><div class="field"><label>ОТОБРАЖАЕМОЕ ИМЯ</label><input id="editPname" value="${esc(p.display_name)}"></div><div class="field"><label>НОВЫЙ ПСЕВДОНИМ</label><input id="editAlias" placeholder="raw nickname"></div><div class="notice">Текущие псевдонимы: ${(p.aliases||[]).map(esc).join(', ')||'—'}</div><button class="btn primary" onclick="savePlayerEdit('${id}')">СОХРАНИТЬ</button></div></div>`)}
function savePlayerEdit(id){const p=player(id);if(!p)return;const name=$('#editPname').value.trim(),alias=$('#editAlias').value.trim();if(!name)return toast('Нужен display name');if(alias&&DB.aliases[alias]&&DB.aliases[alias]!==id)return toast('Этот alias уже привязан к другому игроку');const nextAliases=alias?[...(p.aliases||[]),alias].filter((x,i,a)=>a.indexOf(x)===i):[...(p.aliases||[])];const patch={display_name:name,updated_at:new Date().toISOString(),aliases:nextAliases};const a=additions();if(alias)a.push({kind:'aliases',aliases:{[alias]:id}});a.push({kind:'player_patch',player_id:id,patch});try{persistChange(a,{action:'EDIT_PLAYER',target:id,detail:{display_name:name,alias}})}catch(e){return toast('Не удалось сохранить изменения. Данные не изменены.')}Object.assign(p,patch);if(alias)DB.aliases[alias]=id;closeModal();toast('Игрок обновлён');render()}
function restorePlayer(id){const p=player(id);if(!p)return;const updated_at=new Date().toISOString(),patch={is_active:true,updated_at},a=additions();a.push({kind:'player_patch',player_id:id,patch});try{persistChange(a,{action:'RESTORE_PLAYER',target:id})}catch(e){return toast('Не удалось сохранить изменения. Данные не изменены.')}Object.assign(p,patch);closeModal();toast('Игрок восстановлен');render()}
function archivePlayer(id){const p=player(id);if(!p)return;const updated_at=new Date().toISOString(),patch={is_active:false,updated_at},a=additions();a.push({kind:'player_patch',player_id:id,patch});try{persistChange(a,{action:'ARCHIVE_PLAYER',target:id})}catch(e){return toast('Не удалось сохранить изменения. Данные не изменены.')}Object.assign(p,patch);normalizeState();closeModal();toast('Игрок архивирован');render()}
function restoreMatch(id){const m=DB.matches.find(x=>x.match_id===id);if(!m)return;const a=additions();a.push({kind:'match_patch',match_id:id,patch:{archived:false,archived_at:null}});for(const mp of DB.maps.filter(x=>x.match_id===id))a.push({kind:'map_patch',map_id:mp.map_id,patch:{archived:false}});try{persistChange(a,{action:'RESTORE_MATCH',target:id})}catch(e){return toast('Не удалось сохранить изменения. Данные не изменены.')}m.archived=false;m.archived_at=null;for(const mp of DB.maps.filter(x=>x.match_id===id))mp.archived=false;toast('Матч восстановлен');render()}
function renderMapStatEditor(matchId,mapId){const mp=DB.maps.find(x=>x.map_id===mapId),m=DB.matches.find(x=>x.match_id===matchId);if(!mp||!m)return '';const players=m.player_ids||activePlayers().map(p=>p.player_id),existing=new Map((mp.player_stats||[]).map(r=>[r.player_id,r]));return `<div class="map-edit-card"><div class="section-head"><h3>${esc(mp.map)}</h3><span class="muted">${mp.stats_available?'стата введена':'стата ещё не введена'}</span></div><div class="field"><label>СЧЁТ КАРТЫ</label><input id="score_${esc(mp.map_id)}" value="${esc(mapScoreText(mp)==='—'?'':mapScoreText(mp))}" placeholder="13:10"></div><div class="edit-kda-grid">${players.map(pid=>{const p=player(pid),r=existing.get(pid)||{};return `<div class="edit-kda-row"><b>${esc(p?.display_name||pid)}</b><input data-map="${esc(mp.map_id)}" data-pid="${esc(pid)}" data-k="k" value="${r.kills??''}" placeholder="K"><input data-map="${esc(mp.map_id)}" data-pid="${esc(pid)}" data-k="d" value="${r.deaths??''}" placeholder="D"><input data-map="${esc(mp.map_id)}" data-pid="${esc(pid)}" data-k="a" value="${r.assists??''}" placeholder="A"></div>`}).join('')}</div></div>`}
function openEditMatch(id){const m=DB.matches.find(x=>x.match_id===id);if(!m)return;const maps=matchMaps(m),derived=historicalLobbyGroups(m),hasTeams=derived[0].length>0||derived[1].length>0;window.__editTeamA=hasTeams?[...derived[0]]:[];window.__editTeamB=hasTeams?[...derived[1]]:[];const teamEditor=hasTeams?`<div class="field"><label>КОМАНДЫ</label><div class="team-select-grid"><div><div class="team-select-head"><b>КОМАНДА A</b><span id="editTeamACount">${derived[0].length} / 5</span></div><div id="editTeamA" class="team-drop"></div></div><div><div class="team-select-head"><b>КОМАНДА B</b><span id="editTeamBCount">${derived[1].length} / 5</span></div><div id="editTeamB" class="team-drop"></div></div></div><div id="editPlayerPool" class="pool-grid player-team-pool">${activePlayers().map(p=>`<button type="button" class="pool-chip" data-pid="${esc(p.player_id)}" onclick="cycleEditPlayer('${esc(p.player_id)}')">${esc(p.display_name)}</button>`).join('')}</div><div class="footer-note">Исторический состав может быть неполным. Отсутствующие игроки не добавляются автоматически.</div></div>`:'';document.body.insertAdjacentHTML('beforeend',`<div class="modal-back" id="modal"><div class="modal panel wide"><div class="modal-head"><h2>РЕДАКТИРОВАТЬ СЕРИЮ</h2><button class="close" onclick="closeModal()">×</button></div><div class="two"><div class="field"><label>ДАТА / ВРЕМЯ</label><input id="editPlayedAt" type="datetime-local" value="${esc((m.played_at||'').slice(0,16))}"></div><div class="field"><label>СЧЁТ СЕРИИ</label><input id="editScore" value="${esc(m.series_score||'')}"></div></div>${teamEditor}${maps.map(mp=>renderMapStatEditor(id,mp.map_id)).join('')}<button class="btn primary" onclick="saveMatchEdit('${esc(id)}')">СОХРАНИТЬ И ПЕРЕСЧИТАТЬ</button></div></div>`);if(hasTeams)renderEditTeams()}
function parseScore(v){const m=String(v||'').trim().match(/^(\d+)\s*:\s*(\d+)$/);return m?[+m[1],+m[2]]:null}
function renderEditTeams(){const a=window.__editTeamA||[],b=window.__editTeamB||[],name=id=>player(id)?.display_name||id;document.querySelectorAll('#editPlayerPool .pool-chip').forEach(el=>{const pid=el.dataset.pid,side=a.includes(pid)?'A':b.includes(pid)?'B':'';el.classList.toggle('selected',!!side);el.classList.toggle('team-a-chip',side==='A');el.classList.toggle('team-b-chip',side==='B')});$('#editTeamA').innerHTML=a.map(id=>`<button type="button" class="team-player team-a" onclick="cycleEditPlayer('${esc(id)}')">${esc(name(id))}</button>`).join('');$('#editTeamB').innerHTML=b.map(id=>`<button type="button" class="team-player team-b" onclick="cycleEditPlayer('${esc(id)}')">${esc(name(id))}</button>`).join('');$('#editTeamACount').textContent=`${a.length} / 5`;$('#editTeamBCount').textContent=`${b.length} / 5`}
function cycleEditPlayer(id){let a=window.__editTeamA||[],b=window.__editTeamB||[];if(a.includes(id)){a=a.filter(x=>x!==id);if(b.length<5)b.push(id)}else if(b.includes(id)){b=b.filter(x=>x!==id)}else if(a.length<5)a.push(id);else if(b.length<5)b.push(id);else return toast('Обе команды уже заполнены 5×5');window.__editTeamA=a;window.__editTeamB=b;renderEditTeams()}
function saveMatchEdit(id){const m=DB.matches.find(x=>x.match_id===id);if(!m)return;const score=parseScore($('#editScore')?.value);if(!score)return toast(m.format==='BO1'?'Неверный счёт карты':'Неверный счёт серии');if(m.format==='BO3'&&!(Math.max(...score)===2&&Math.min(...score)<=1))return toast('Для BO3 используй 2:0 или 2:1');if(m.format==='BO5'&&!(Math.max(...score)===3&&Math.min(...score)<=2))return toast('Для BO5 используй 3:0, 3:1 или 3:2');const editA=[...new Set(window.__editTeamA||[])].slice(0,5),editB=[...new Set(window.__editTeamB||[])].slice(0,5);if(editA.some(x=>editB.includes(x)))return toast('Один игрок не может быть в двух командах');const teamOps=(editA.length||editB.length)?[{kind:'match_patch',match_id:id,patch:{team_a:editA,team_b:editB,player_ids:[...editA,...editB],team_assignment_source:'manual_edit'}}]:[];const allInputs=[...document.querySelectorAll('[data-map]')];if(!allInputs.length&&$('#editRows')){const rows=$('#editRows').value.trim().split(/\n+/).map(x=>x.trim()).filter(Boolean);if(rows.length!==10)return toast('Нужен ровно 10 игроков');const ps=[];for(const line of rows){const z=line.match(/^(.+?)\s+(\d+)\s*\/\s*(\d+)\s*\/\s*(\d+)$/);if(!z)return toast('Строка не распознана: '+line);const pid=DB.aliases[z[1]]||activePlayers().find(p=>p.player_id===z[1])?.player_id;if(!pid)return toast('Неизвестный игрок: '+z[1]);ps.push({raw_name:z[1],player_id:pid,kills:+z[2],deaths:+z[3],assists:+z[4]})}const a=additions();a.push(...teamOps);const patch={played_at:$('#editPlayedAt')?.value||m.played_at,series_score:m.format==='BO1'?`${score[0]>score[1]?1:0}:${score[1]>score[0]?1:0}`:`${score[0]}:${score[1]}`};a.push({kind:'match_patch',match_id:id,patch});if(m.format==='BO1'){const mp=matchMaps(m)[0];a.push({kind:'map_patch',map_id:mp.map_id,patch:{player_stats:ps,stats_available:true,score:{team_a:score[0],team_b:score[1]}}})}else a.push({kind:'match_patch',match_id:id,patch:{series_aggregate_stats:ps}});try{persistChange(a,{action:'EDIT_MATCH',target:id,detail:{score,players:10}})}catch(e){return toast('Не удалось сохранить изменения.')}Object.assign(m,patch);if(m.format==='BO1'){const mp=matchMaps(m)[0];Object.assign(mp,{player_stats:ps,stats_available:true,score:{team_a:score[0],team_b:score[1]}})}else m.series_aggregate_stats=ps;closeModal();toast('Матч обновлён');render();return}const ops=[...teamOps];for(const mp of matchMaps(m)){const inputs=[...document.querySelectorAll(`[data-map="${mp.map_id}"]`)],by=new Map();for(const el of inputs){const pid=el.dataset.pid;if(!by.has(pid))by.set(pid,{player_id:pid,raw_name:player(pid)?.display_name||pid,kills:0,deaths:0,assists:0});const v=el.value.trim();if(v!==''&&!/^\d+$/.test(v))return toast('K/D/A должны быть целыми числами');if(el.dataset.k==='k')by.get(pid).kills=v===''?0:+v;if(el.dataset.k==='d')by.get(pid).deaths=v===''?0:+v;if(el.dataset.k==='a')by.get(pid).assists=v===''?0:+v}const entered=[...by.values()].filter(r=>inputs.some(el=>el.dataset.pid===r.player_id&&el.value.trim()!=='')),sc=parseScore($(`#score_${mp.map_id}`)?.value||'');ops.push({kind:'map_patch',map_id:mp.map_id,patch:{player_stats:entered,stats_available:entered.length===10,...(sc?{score:{team_a:sc[0],team_b:sc[1]}}:{})}})}const totals=new Map();for(const op of ops)if(op.kind==='map_patch')for(const r of op.patch.player_stats){if(!totals.has(r.player_id))totals.set(r.player_id,{player_id:r.player_id,raw_name:r.raw_name,kills:0,deaths:0,assists:0});const t=totals.get(r.player_id);t.kills+=r.kills;t.deaths+=r.deaths;t.assists+=r.assists}ops.push({kind:'match_patch',match_id:id,patch:{played_at:$('#editPlayedAt')?.value||m.played_at,series_score:`${score[0]}:${score[1]}`,series_aggregate_stats:[...totals.values()]}});try{persistChange(ops,{action:'EDIT_MATCH',target:id,detail:{maps:ops.length-1}})}catch(e){return toast('Не удалось сохранить изменения.')}for(const op of ops){if(op.kind==='map_patch')Object.assign(DB.maps.find(x=>x.map_id===op.map_id),op.patch);else Object.assign(m,op.patch)}closeModal();toast('Серия обновлена');render()}
function deleteMatch(id){const m=DB.matches.find(x=>x.match_id===id);if(!m)return;if(m.archived!==true){const a=additions();a.push({kind:'match_patch',match_id:id,patch:{archived:true,archived_at:new Date().toISOString()}});for(const mp of DB.maps.filter(x=>x.match_id===id))a.push({kind:'map_patch',map_id:mp.map_id,patch:{archived:true}});try{persistChange(a,{action:'ARCHIVE_MATCH',target:id})}catch(e){return toast('Не удалось переместить матч в корзину.')}m.archived=true;DB.maps.filter(x=>x.match_id===id).forEach(x=>x.archived=true);toast('Матч перемещён в корзину');render();return}const ops=DB.maps.filter(x=>x.match_id===id).map(mp=>({kind:'map_patch',map_id:mp.map_id,patch:{archived:true,deleted_permanently:true}}));ops.push({kind:'match_patch',match_id:id,patch:{archived:true,deleted_permanently:true,deleted_at:new Date().toISOString()}});try{persistChange(ops,{action:'DELETE_MATCH_PERMANENT',target:id})}catch(e){return toast('Не удалось удалить матч окончательно.')}DB.matches=DB.matches.filter(x=>x.match_id!==id);DB.maps=DB.maps.filter(x=>x.match_id!==id);toast('Матч удалён окончательно');render()}
function archiveMatch(id){deleteMatch(id)}
function openTrash(){if(!state.logged)return toast('Требуется режим администратора');const archived=DB.matches.filter(m=>m.archived===true).slice().sort((a,b)=>matchTime(b)-matchTime(a));const rows=archived.map(m=>{const maps=matchMaps(m);return `<div class="trash-series-row"><div class="trash-series-main"><span class="pill">КОРЗИНА</span><b>${esc(m.format||'МАТЧ')} · ${esc(m.series_score||'—')}</b><span>${maps.map(x=>esc(x.map)).join(' · ')||'—'}</span>${m.played_at?`<small>${esc(m.played_at)}</small>`:''}</div><div class="toolbar"><button class="btn mini" onclick="openMatchDetail('${esc(m.match_id)}')">СТАТИСТИКА</button><button class="btn mini primary" onclick="restoreMatch('${esc(m.match_id)}')">ВОССТАНОВИТЬ</button><button class="btn mini danger" onclick="deleteMatch('${esc(m.match_id)}')">УДАЛИТЬ НАВСЕГДА</button></div></div>`}).join('');document.body.insertAdjacentHTML('beforeend',`<div class="modal-back" id="modal"><div class="modal panel wide"><div class="modal-head"><h2>КОРЗИНА</h2><button class="close" onclick="closeModal()">×</button></div><div class="trash-list">${rows||'<div class="empty">Корзина пуста.</div>'}</div></div></div>`)}
function openAddGame(){if(!state.logged){state.tab='settings';render();return}const mapPool=[...new Set(DB.maps.filter(x=>x.archived!==true).map(x=>x.map))].sort(),players=activePlayers();document.body.insertAdjacentHTML('beforeend',`<div class="modal-back" id="modal"><div class="modal panel wide"><div class="modal-head"><h2>ДОБАВИТЬ ИГРУ / СЕРИЮ</h2><button class="close" onclick="closeModal()">×</button></div><div class="two"><div class="field"><label>ФОРМАТ</label><select id="newFormat"><option value="BO1">BO1</option><option value="BO3">BO3</option><option value="BO5">BO5</option></select></div><div class="field"><label>СЧЁТ КАРТЫ</label><input id="newScore" placeholder="13:10 / 2:1 / 3:2"><span id="newScoreHint" class="muted">Для BO1 — счёт карты, например 13:10.</span></div></div><div class="field"><label>КАРТЫ ИЗ ПУЛА</label><div id="newMapPool" class="pool-grid">${mapPool.map(n=>`<button type="button" class="pool-chip" data-map="${esc(n)}" onclick="toggleNewMap('${esc(n)}')">${esc(n)}</button>`).join('')}</div><span class="muted">BO1: 1 · BO3: 2–3 · BO5: 2–5</span></div><div class="field"><label>10 ИГРОКОВ · РАСПРЕДЕЛЕНИЕ КОМАНД</label><div class="team-select-grid"><div><div class="team-select-head"><b>КОМАНДА A</b><span id="newTeamACount">0 / 5</span></div><div id="newTeamA" class="team-drop"></div></div><div><div class="team-select-head"><b>КОМАНДА B</b><span id="newTeamBCount">0 / 5</span></div><div id="newTeamB" class="team-drop"></div></div></div><div id="newPlayerPool" class="pool-grid player-team-pool">${players.map(p=>`<button type="button" class="pool-chip" data-pid="${esc(p.player_id)}" onclick="cycleNewPlayer('${esc(p.player_id)}')">${esc(p.display_name)}</button>`).join('')}</div><span id="newPlayerCount" class="muted">0 / 10 · клик: A → B → снять</span></div><div class="field"><label>ДАТА / ВРЕМЯ</label><input id="newPlayedAt" type="datetime-local"></div><button class="btn primary" onclick="saveGame()">СОЗДАТЬ СЕРИЮ</button></div></div>`);window.__newMaps=[];window.__newTeamA=[];window.__newTeamB=[];syncNewFormatUI();renderNewTeams()}
function toggleNewMap(name){let a=window.__newMaps||[],f=$('#newFormat').value,max=f==='BO1'?1:f==='BO3'?3:5;if(a.includes(name))a=a.filter(x=>x!==name);else{if(a.length>=max)return toast(`Для ${f} максимум ${max} карт`);a.push(name)}window.__newMaps=a;document.querySelectorAll('#newMapPool .pool-chip').forEach(b=>b.classList.toggle('selected',a.includes(b.dataset.map)))}
function renderNewTeams(){const a=window.__newTeamA||[],b=window.__newTeamB||[],all=[...a,...b];document.querySelectorAll('#newPlayerPool .pool-chip').forEach(el=>{const pid=el.dataset.pid,side=a.includes(pid)?'A':b.includes(pid)?'B':'';el.classList.toggle('selected',!!side);el.classList.toggle('team-a-chip',side==='A');el.classList.toggle('team-b-chip',side==='B');el.dataset.team=side});const playerName=id=>activePlayers().find(p=>p.player_id===id)?.display_name||id;$('#newTeamA').innerHTML=a.map(id=>`<button type="button" class="team-player team-a" onclick="cycleNewPlayer('${esc(id)}')">${esc(playerName(id))}</button>`).join('')||'<span class="team-empty">Перетащи сюда через клик по игроку</span>';$('#newTeamB').innerHTML=b.map(id=>`<button type="button" class="team-player team-b" onclick="cycleNewPlayer('${esc(id)}')">${esc(playerName(id))}</button>`).join('')||'<span class="team-empty">Пока пусто</span>';$('#newTeamACount').textContent=`${a.length} / 5`;$('#newTeamBCount').textContent=`${b.length} / 5`;$('#newPlayerCount').textContent=`${all.length} / 10 · клик: A → B → снять`}
function cycleNewPlayer(id){let a=window.__newTeamA||[],b=window.__newTeamB||[];if(a.includes(id)){a=a.filter(x=>x!==id);if(b.length<5)b.push(id)}else if(b.includes(id)){b=b.filter(x=>x!==id)}else if(a.length<5)a.push(id);else if(b.length<5)b.push(id);else return toast('Обе команды уже заполнены 5×5');window.__newTeamA=a;window.__newTeamB=b;renderNewTeams()}
function toggleNewPlayer(id){cycleNewPlayer(id)}
function syncNewFormatUI(){const f=$('#newFormat')?.value||'BO1';const label=document.querySelector('#newScore')?.previousElementSibling;if(label)label.textContent=f==='BO1'?'СЧЁТ КАРТЫ':'СЧЁТ СЕРИИ';const hint=$('#newScoreHint');if(hint)hint.textContent=f==='BO1'?'Для BO1 — счёт карты, например 13:10.':'Для серии — счёт серии, например 2:1 или 3:2.';document.querySelectorAll('#newMapPool .pool-chip').forEach(b=>b.classList.toggle('disabled-chip',false));}
function saveGame(){const rawFormat=$('#newFormat').value;const format=rawFormat==='BO3_COMPACT'?'BO3':rawFormat;const legacyCompact=rawFormat==='BO3_COMPACT';let maps=window.__newMaps||[];let teamA=window.__newTeamA||[],teamB=window.__newTeamB||[],pids=[...teamA,...teamB];if(!maps.length&&$('#newMaps')?.value)maps=$('#newMaps').value.split(',').map(x=>x.trim().toLowerCase()).filter(Boolean);if(!pids.length&&$('#newRows')?.value){pids=$('#newRows').value.trim().split(/\n+/).map(x=>x.trim()).filter(Boolean).map(line=>{const q=line.match(/^(.+?)\s+\d+\s*\/\s*\d+\s*\/\s*\d+$/);return q?(DB.aliases[q[1]]||activePlayers().find(p=>p.player_id===q[1])?.player_id):null}).filter(Boolean)}const legacyRows=$('#newRows')?.value?$('#newRows').value.trim().split(/\n+/).map(x=>x.trim()).filter(Boolean).map(line=>{const q=line.match(/^(.+?)\s+(\d+)\s*\/\s*(\d+)\s*\/\s*(\d+)$/);if(!q)return null;const pid=DB.aliases[q[1]]||activePlayers().find(p=>p.player_id===q[1])?.player_id;return pid?{raw_name:q[1],player_id:pid,kills:+q[2],deaths:+q[3],assists:+q[4]}:null}).filter(Boolean):[];const score=parseScore($('#newScore').value);if(!score)return toast('Введи счёт');if((format==='BO1'&&maps.length!==1)||(format==='BO3'&&(maps.length<2||maps.length>3))||(format==='BO5'&&(maps.length<2||maps.length>5)))return toast('Неверное количество карт для формата');if(teamA.length!==5||teamB.length!==5)return toast('Распредели ровно 5 игроков в каждую команду');if(format==='BO3'&&!(Math.max(...score)===2&&Math.min(...score)<=1))return toast('Для BO3 используй 2:0 или 2:1');if(format==='BO5'&&!(Math.max(...score)===3&&Math.min(...score)<=2))return toast('Для BO5 используй 3:0, 3:1 или 3:2');const now=Date.now(),mid=`match_local_${now}`,ops=additions(),mapIds=[];maps.forEach((name,i)=>{const id=`map_local_${now}_${i+1}`,detailed=format==='BO1'&&legacyRows.length===10,obj={map_id:id,match_id:mid,map_index:i+1,map:name,score:format==='BO1'?{team_a:score[0],team_b:score[1]}:null,stats_available:detailed,player_stats:detailed?legacyRows:[],source_header:'local admin entry'};mapIds.push(id);ops.push({kind:'map',map:obj})});const match={match_id:mid,played_at:$('#newPlayedAt').value||'',source_kind:legacyCompact?'compact_bo3':'local_series',format,header:`${format.toLowerCase()} ${score[0]}:${score[1]} ${maps.join('-')}`,map_ids:mapIds,series_score:`${score[0]}:${score[1]}`,series_stats_available:legacyCompact&&legacyRows.length===10,series_score_source:'local_admin',series_aggregate_stats:legacyCompact?legacyRows:[],player_ids:pids,team_a:teamA,team_b:teamB};ops.push({kind:'match',match});try{persistChange(ops,{action:'CREATE_MATCH',target:mid,detail:{format,maps,score,players:10}})}catch(e){return toast('Не удалось сохранить игру.')}DB.maps.push(...maps.map((n,i)=>({map_id:mapIds[i],match_id:mid,map_index:i+1,map:n,score:format==='BO1'?{team_a:score[0],team_b:score[1]}:null,stats_available:format==='BO1'&&legacyRows.length===10,player_stats:format==='BO1'&&legacyRows.length===10?legacyRows:[],source_header:'local admin entry'})));DB.matches.push(match);closeModal();toast('Серия создана. Стату теперь можно вводить по каждой карте отдельно.');render()}
function closeModal(){document.getElementById('modal')?.remove()}
function exportBackup(){try{if(!validateBase(DB)||!validateBase(BASE))throw Error('invalid current base');const payload={version:'site-v39',exported_at:new Date().toISOString(),base:{players:BASE.players,maps:BASE.maps,matches:BASE.matches,aliases:BASE.aliases},localStorage:additions(),audit:auditLog()};const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='CS2_ANALYTICS_backup_'+Date.now()+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);toast('Backup создан.');}catch(e){toast('Не удалось создать backup. Текущая база не изменена.')}}
function importBackup(file){if(!file)return;const r=new FileReader();r.onload=()=>{try{const x=JSON.parse(r.result),b=x.base;if(!validateBase(b))throw Error('invalid');const importedAdditions=Array.isArray(x.localStorage)?x.localStorage:[];const nextAdd=JSON.stringify(importedAdditions),nextBase=JSON.stringify(b),nextAudit=JSON.stringify(Array.isArray(x.audit)?x.audit:[]),oldBase=localStorage.getItem('cs2_analytics_base_override'),oldAdd=localStorage.getItem('cs2_analytics_additions'),oldAudit=localStorage.getItem('cs2_analytics_audit_log');try{if(importedAdditions.length){const probe=JSON.parse(nextBase);for(const op of importedAdditions){if(!op||typeof op!=='object'||!['map','match','player','aliases','player_patch','match_patch','map_patch'].includes(op.kind))throw Error('invalid backup local operation');if(op.kind==='map'&&(!op.map||typeof op.map!=='object'))throw Error('map payload missing');if(op.kind==='match'&&(!op.match||typeof op.match!=='object'))throw Error('match payload missing');if(op.kind==='player'&&(!op.player||typeof op.player!=='object'))throw Error('player payload missing');if(op.kind==='aliases'&&(!op.aliases||typeof op.aliases!=='object'||Array.isArray(op.aliases)))throw Error('aliases payload missing');if(['player_patch','match_patch','map_patch'].includes(op.kind)&&(!op.patch||typeof op.patch!=='object'||Array.isArray(op.patch)))throw Error('patch payload missing');if(op.kind==='map'&&op.map)probe.maps.push(op.map);if(op.kind==='match'&&op.match)probe.matches.push(op.match);if(op.kind==='player'&&op.player)probe.players.push(op.player);if(op.kind==='aliases')Object.assign(probe.aliases,op.aliases||{});if(op.kind==='player_patch'){const q=probe.players.find(z=>z.player_id===op.player_id);if(!q)throw Error('missing player patch target');Object.assign(q,op.patch||{})}if(op.kind==='match_patch'){const q=probe.matches.find(z=>z.match_id===op.match_id);if(!q)throw Error('missing match patch target');Object.assign(q,op.patch||{})}if(op.kind==='map_patch'){const q=probe.maps.find(z=>z.map_id===op.map_id);if(!q)throw Error('missing map patch target');Object.assign(q,op.patch||{})}}if(!validateBase(probe))throw Error('invalid backup local operation state')}if(!validateBase(b))throw Error('invalid backup base');localStorage.setItem('cs2_analytics_base_override',nextBase);localStorage.setItem('cs2_analytics_additions',nextAdd);localStorage.setItem('cs2_analytics_audit_log',nextAudit);if(localStorage.getItem('cs2_analytics_base_override')!==nextBase||localStorage.getItem('cs2_analytics_additions')!==nextAdd||localStorage.getItem('cs2_analytics_audit_log')!==nextAudit)throw Error('storage verification failed')}catch(e){try{if(oldBase===null)localStorage.removeItem('cs2_analytics_base_override');else localStorage.setItem('cs2_analytics_base_override',oldBase);if(oldAdd===null)localStorage.removeItem('cs2_analytics_additions');else localStorage.setItem('cs2_analytics_additions',oldAdd);if(oldAudit===null)localStorage.removeItem('cs2_analytics_audit_log');else localStorage.setItem('cs2_analytics_audit_log',oldAudit)}catch{};throw e}location.reload()}catch(e){toast('Неверный или повреждённый backup. Текущая база не изменена.')}};r.readAsText(file)}
document.onclick=e=>{if(e.target?.classList?.contains('modal-back'))e.target.remove()};
window.openAddGame=openAddGame;window.openMatchDetail=openMatchDetail;window.openPlayerAdmin=openPlayerAdmin;window.savePlayerAdmin=savePlayerAdmin;window.editPlayer=editPlayer;window.savePlayerEdit=savePlayerEdit;window.restorePlayer=restorePlayer;window.archivePlayer=archivePlayer;window.openEditMatch=openEditMatch;window.saveMatchEdit=saveMatchEdit;window.restoreMatch=restoreMatch;window.archiveMatch=archiveMatch;window.deleteMatch=deleteMatch;window.openTrash=openTrash;window.closeModal=closeModal;window.togglePlayer=togglePlayer;window.selectAllPlayers=selectAllPlayers;window.clearPlayers=clearPlayers;window.focusPlayer=focusPlayer;window.openPlayerDetail=openPlayerDetail;window.openWhyIndex=openWhyIndex;window.closePlayerDetail=closePlayerDetail;window.renderMapLab=renderMapLab;window.openMapDetail=openMapDetail;window.addToTeam=addToTeam;window.removeFromTeam=removeFromTeam;window.saveGame=saveGame;window.randomTeams=randomTeams;window.balanceTeams=balanceTeams;window.exportBackup=exportBackup;window.importBackup=importBackup;window.login=login;window.toast=toast;window.state=state;window.render=render;
function closeTopModal(){const modals=[...document.querySelectorAll('.modal-back')];if(!modals.length)return false;modals.at(-1).remove();return true}
function globalKeyboardShortcuts(e){if(e.key==='Escape'&&closeTopModal())e.preventDefault()}
document.addEventListener('keydown',globalKeyboardShortcuts);
load();

// V47.1 scroll safety: when a modal is open, wheel input over non-scrollable children
// is routed to the modal itself, preventing nested cards/hover targets from swallowing it.
if(document.addEventListener)document.addEventListener('wheel',e=>{
  const modal=e.target?.closest?.('.modal');
  if(!modal)return;
  let el=e.target;
  while(el&&el!==modal){
    const cs=getComputedStyle(el);
    const canScroll=/(auto|scroll)/.test(cs.overflowY)&&el.scrollHeight>el.clientHeight;
    if(canScroll){
      const down=e.deltaY>0,atTop=el.scrollTop<=0,atBottom=el.scrollTop+el.clientHeight>=el.scrollHeight-1;
      if((down&&!atBottom)||(!down&&!atTop))return;
    }
    el=el.parentElement;
  }
  const max=modal.scrollHeight-modal.clientHeight;
  if(max>0){e.preventDefault();modal.scrollTop=Math.max(0,Math.min(max,modal.scrollTop+e.deltaY));}
},{passive:false,capture:true});
